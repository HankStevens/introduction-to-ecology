.Rproj.user/
.Rhistory
.RData
.Ruserdata
.Renviron

# ============================================
# Quarto output & internals
# ============================================
.quarto/
# Anchored to repo root (leading /) so these only ignore the source-adjacent
# scratch/cache dirs Quarto creates next to a .qmd file (e.g. /06-DI-pop-growth_files/).
# Un-anchored (*_cache/, *_files/) also matched the SAME-NAMED folders Quarto
# creates INSIDE docs/ to hold each chapter's actual published figures
# (docs/<chapter>_files/figure-html/*.png) -- which must be tracked, since
# that's the real content GitHub Pages serves. That bug meant every chapter's
# images were silently never committed. Fixed 2026-09-01.
/*_cache/
**/*.quarto_ipynb
/*_files/
practice_problems/
misc/
pedagogy/
practice_problems/
worcountfiles/
site-snapshots/

# Stale pre-"docs/" book output dir. _quarto.yml now sets
# `output-dir: docs`, so `quarto render` no longer writes here at all --
# this folder is an orphaned build artifact left from before that change.
_book/

# ============================================
# OS junk
# ============================================
.DS_Store

