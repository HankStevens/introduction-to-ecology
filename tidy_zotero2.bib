@article{
  title = {Ancient {{Maya Agroforestry Echoing}} through {{Spatial Relationships}} in the {{Extant Forest}} of {{NW Belize}}},
  author = {Ross, Nanci J. and Rangel, Thiago F.},
  date = {2011},
  journaltitle = {Biotropica},
  volume = {43},
  number = {2},
  pages = {141--148},
  issn = {00063606},
  abstract = {Previous research has shown that ancient Maya `forest\textbackslash textbackslash ngardens'-tree-dominated home gardens containing a diversity of tree\textbackslash textbackslash nspecies used for daily household needs-still resonate in the species\textbackslash textbackslash ncomposition of the modern forest. Centuries of positive interspecies\textbackslash textbackslash ninteractions may enhance the reproductive and survival success of garden\textbackslash textbackslash nspecies selected and encouraged by experienced Maya forest gardeners. We\textbackslash textbackslash nhypothesized that such interaction may result in aggregated spatial\textbackslash textbackslash npatterns between 32 pre-selected, commonly utilized forest garden\textbackslash textbackslash nspecies. In this paper, we developed a novel randomization (Monte Carlo)\textbackslash textbackslash nmethod designed to measure and test if the spatial relationships among\textbackslash textbackslash npairs of Maya `forest garden' trees species differ between areas that\textbackslash textbackslash nexperienced high and low ancient settlement density in northwestern\textbackslash textbackslash nBelize. A total of 28 high ancient settlement density and 27 low ancient\textbackslash textbackslash nsettlement density plots containing a total of 2772 and 3134 trees,\textbackslash textbackslash nrespectively, were used for this study. The analysis revealed that 58\textbackslash textbackslash npairs of forest garden species tended to `cluster' together\textbackslash textbackslash nsignificantly more often in the high settlement density areas than would\textbackslash textbackslash nbe expected in a random distribution. In low settlement density plots,\textbackslash textbackslash nonly 12 pairs of species exhibited a significant clustered spatial\textbackslash textbackslash nrelationship. The effect was not species specific, suggesting that some\textbackslash textbackslash nsynergistic relationships, mediated by third-party agents such as\textbackslash textbackslash ndispersers, may occur at the community level. The impacts of ancient\textbackslash textbackslash nhuman land use, echoing across centuries of dispersal, colonization,\textbackslash textbackslash ndisturbance, and biotic and abiotic interactions, can have important\textbackslash textbackslash nimplications for understanding the current biodiversity patterns and\textbackslash textbackslash nprocesses.\textbackslash textbackslash nAbstract in Spanish is available at {$<$}externallink\textbackslash textbackslash nid=\{”\}http://www.blackwell-synergy.com/loi/btp\{”\}\textbackslash textbackslash ntype=\{”\}url\{”\}{$>$}http://www.blackwell-synergy.com/loi/btp.},
  isbn = {0006-3606},
  keywords = {Ancient land use,Maya,Monte Carlo,Pairwise distances,Synergisms,Tropical forest community dynamics}
}

@article{
  title = {Modern {{Tree Species Composition Reflects Ancient Maya Forest Gardens}} in {{Northwest Belize}}},
  author = {Ross, Nanci J},
  date = {2011},
  journaltitle = {Source: Ecological Applications Ecological Applications},
  volume = {21},
  number = {211},
  eprint = {29779638{%}5Cnhttp://www.jstor.org/stable/29779638},
  eprinttype = {JSTOR},
  pages = {75--84},
  abstract = {Ecology and ethnobotany were integrated to assess the impact of ancient Maya tree-dominated home gardens (i.e., "forest gardens"), which contained a diversity of tree species used for daily household needs, on the modern tree species composition of a Mesoamerican forest. Researchers have argued that the ubiquity of these ancient gardens throughout Mesoamerica led to the dominance of species useful to Maya in the contemporary forest, but this pattern may be localized depending on ancient land use. The tested hypothesis was that species composition would be significantly different between areas of dense ancient residential structures (high density) and areas of little or no ancient settlement (low density). Sixty-three 400-m2 plots (31 high density and 32 low density) were censused around the El Pilar Archaeological Reserve in northwestern Belize. Species composition was significantly different, with higher abundances of commonly utilized "forest garden" species still persisting in high-density forest areas despite centuries of abandonment. Subsequent edaphic analyses only explained 5\% of the species composition differences. This research provides data on the long-term impacts of Maya forests gardens for use in development of future conservation models. For Mesoamerican conservation programs to work, we must understand the complex ecological and social interactions within an ecosystem that developed in intimate association with humans.},
  isbn = {1051-0761},
  keywords = {Belize,canonical correspondence analysis,CCA,El Pilar Archaeological Reserve,ethnoecology,forest gardens,historical ecology,Maya,Mesoamerica,tree species composition}
}

@article{
  title = {Short-{{Term}} and {{Latent Post-Settlement Effects Associated}} with {{Elevated Temperature}} and {{Oxidative Stress}} on {{Larvae}} from the {{Coral Porites Astreoides}}},
  author = {Ross, C. and Ritson-Williams, R. and Olsen, K. and Paul, V. J.},
  date = {2013},
  journaltitle = {Coral reefs (Online)},
  volume = {32},
  number = {1},
  pages = {71--79},
  issn = {07224028},
  abstract = {Coral reefs across the Caribbean are undergoing unprecedented rates of decline in coral cover during the last three decades, and coral recruitment is one potential process that could aid the recovery of coral populations. To better understand the effects of climate change on coral larval ecology, the larvae of Porites astreoides were studied to determine the immediate and post-settlement effects of elevated temperature and associated oxidative stress. Larvae of Porites astreoides were exposed to 27 C (ambient) and ?3.0 C (elevated temperature) seawater for a short duration of 24 h; then, a suite of physiological parameters were measured to determine the extent of sublethal stress. Following the ?3.0 C treatment, larvae did not show a significant difference in maximum quantum yield of PSII (Fv/Fm) or respiratory demand when compared to controls maintained at 27 C. The addition of micromolar concentrations of hydrogen peroxide did not impact respiration or photochemical efficiency. Catalase activity in the larvae increased ([60 \%) following exposure to elevated temperature when compared to the controls. Short-term larval survival and settlement and metamorphosis were not affected by increased temperature or the H2O2 treatment. However, the settled spat that were exposed to elevated temperature underwent a 99 \% reduction in survival compared to 90 \% reduction for the control spat when examined 24 days following the deployment of 4-day-old settled spat on settlement tiles in the field. These results show that short-term exposure to some stressors might have small impacts on coral physiology, and no effects on larval survival, settlement and metamorphosis. However, due to post-settlement mortality, these stressors can cause a significant reduction in coral recruitment.},
  isbn = {0722-4028},
  keywords = {Coral recruitment,Larval ecology,Latent effects,Oxidative stress,Settlement,Thermal stress}
}

@article{
  title = {The {{Ecological Side}} of an {{Ethnobotanical Coin}}: {{Legacies}} in {{Historically Managed Trees}}.},
  author = {Ross, Nanci J and Stevens, M Henry H and Rupiper, Andrew W and Harkreader, Ian and family=Leben, given=Laura, prefix=a, useprefix=true},
  date = {2014-10},
  journaltitle = {American journal of botany},
  volume = {101},
  number = {10},
  eprint = {25326611},
  eprinttype = {pubmed},
  pages = {1618--30},
  issn = {1537-2197},
  abstract = {PREMISE OF THE STUDY: A growing body of literature now documents how ancient human management of the landscape echoes through to extant environments in eastern North America. Plant domestication is a major theme in the study of human-nature interactions. Long-term ecological impacts of human selection may last for centuries after management ends, yet little work has focused on legacies in the evolution of historically used trees. Ecological data will be valuable in teasing apart myriad variables that confound questions of land-use legacies. We discuss the potential for legacies of ancient human selection and present a preliminary case study for the approach of integrating ecological and historical data for Diospyros virginiana, the American persimmon.* METHODS: Herbarium samples of D. virginiana (28 male and 40 female) from across the species range provided specimen localities for edaphic analysis. Soil and environmental data were analyzed using nonparametric ordination, Wilcoxon summed rank test, and permutational MANOVA.* KEY RESULTS: Edaphic data demonstrated substantial variation among sites, but revealed no significant differences between sexes. Permutational MANOVA showed no difference in environmental preferences for the tested variables between male and female trees (R(2) {$<$} 0.01, P = 0.8).* CONCLUSIONS: Extending our understanding of landscape history to the long-term impacts of artificial selection at the species or population level would be valuable in both theoretical and applied botanical research. Multidisciplinary approaches integrating ecological data will be essential for investigation of the evolutionary implications of historical human selection in economic species and the potential for adaptive flexibility in reproductive systems of long-lived perennials.},
  keywords = {150 yr ago,50,american persimmon,artifi cial selection,diospyros virginiana,domestication,ebenaceae,effects of recent historical,especially,land use,land use legacies,leaky dioecy,natural systems have received,on,signifi cant attention,unconscious selection}
}

