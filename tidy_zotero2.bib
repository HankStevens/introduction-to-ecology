@article{
  title = {Growth and \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}urvival of \{\textbackslash vphantom\}{{W}}\textbackslash vphantom\{\}elfia-\{\textbackslash vphantom\}{{G}}\textbackslash vphantom\{\}eorgii \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}eedlings in a \{\textbackslash vphantom\}{{R}}\textbackslash vphantom\{\}ain- \{\textbackslash vphantom\}{{F}}\textbackslash vphantom\{\}orest of the \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}aribbean \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}oast of \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}osta-\{\textbackslash vphantom\}{{R}}\textbackslash vphantom\{\}ica},
