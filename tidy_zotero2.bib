@article{
  title = {Concepts \& {{Synthesis}} a {{Global Evaluation}} of {{Metabolic Theory}} as an {{Explanation}}},
  author = {{Hawkins} and {a}, Bradford and Albuquerque, FAbio S and Araújo, Miguel B. and Beck, Jan and Bini, Luis M. and Cabrero-Sanudo, Francisco, J. and Castro-Parga, Isabel and family=Diniz-Filho, given=José, prefix=a.F., useprefix=true and Ferrer-Castán, Dolores and Field, Richard and Góez, José F. and Joaquín Hortal, Jeremy T. Kerr and {Ian J. Kitching, Jorge L. León-Cortés, Jorge M. Lobo, Daniel Montoya, Juan Carlos Moreno, Miguel Á .Olalla-Tárraga, Juli G. Pausas, Hong Qian, Carsten Rahbek, Miguel Á .Rodríguez, Nathan J. Sanders} and Williams, Paul},
