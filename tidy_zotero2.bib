@article{
  title = {Use of {{Plant Roots}} for {{Phytoremediation}} and {{Molecular Farming}}.},
  author = {Gleba, D and Borisjuk, N V and Borisjuk, L G and Kneer, R and Poulev, a and Skarzhinskaya, M and Dushenkov, S and Logendra, S and Gleba, Y Y and Raskin, I},
  date = {1999},
  journaltitle = {Proceedings of the National Academy of Sciences of the United States of America},
  volume = {96},
  number = {11},
  eprint = {10339526},
  eprinttype = {pubmed},
  pages = {5973--5977},
  issn = {0027-8424},
  abstract = {Alternative agriculture, which expands the uses of plants well beyond food and fiber, is beginning to change plant biology. Two plant-based biotechnologies were recently developed that take advantage of the ability of plant roots to absorb or secrete various substances. They are (i) phytoextraction, the use of plants to remove pollutants from the environment and (ii) rhizosecretion, a subset of molecular farming, designed to produce and secrete valuable natural products and recombinant proteins from roots. Here we discuss recent advances in these technologies and assess their potential in soil remediation, drug discovery, and molecular farming.},
  isbn = {0027-8424 (Print)}
}

@article{
  title = {Character \{\textbackslash vphantom\}{{D}}\textbackslash vphantom\{\}isplacement in \{\textbackslash vphantom\}{{F}}\textbackslash vphantom\{\}lowering \{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}henologies},
  author = {Gleeson, S K},
  date = {1981},
  journaltitle = {Oecologia},
