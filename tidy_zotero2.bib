@article{
  title = {Multiple {{Stable States}} and {{Hysteresis}} in {{Continuous}}, {{Oscillating Cultures}} of {{Budding Yeast}}},
  author = {Zamamiri, Abdel Qader M. and Birol, Gülnur and Hjortsø, Martin A.},
  date = {2001},
  journaltitle = {Biotechnology and Bioengineering},
  volume = {75},
  number = {3},
  eprint = {11590603},
  eprinttype = {pubmed},
  pages = {305--312},
  issn = {00063592},
  abstract = {The conditions that precede the onset of autonomous oscillations in continuous yeast cultures were studied in three different types of experiments. It was found that the final state of the culture depended on the protocol used to start up the reactor. Batch cultures, switched to continuous operation at different stages of the batch growth curve, all exhibited similar dynamics-ethanol depletion followed by autonomous oscillations. Small perturbations of the distribution of states in the reactor, achieved by addition of externally grown cells, were able to quench the oscillatory dynamics. Reaching the desired operating point by slow dilution rate changes gave rise to different final states, two oscillatory states and one steady state, depending on the rate of change in dilution rate. The multiplicity of stable states at a single operating point is not explained by any current distributed model and points toward a segregated mechanism of these oscillations.},
  isbn = {0006-3592},
  keywords = {Autonomous oscillations,Saccharomyces cerevisiae,Synchronous culture}
}

@article{
  title = {\textbackslash textbackslash emph\{\{\textbackslash vphantom\}\}{{E}}\textbackslash vphantom\{\}scherichia {{Coli}}\textbackslash vphantom\{\} {{Mutants Lacking}} \{\textbackslash vphantom\}{{N}}\textbackslash vphantom\{\}ad\{\textbackslash vphantom\}{{H}}\textbackslash vphantom\{\} {{Dehydrogenase-}}\{\textbackslash vphantom\}{{I}}\textbackslash vphantom\{\} {{Have}} a {{Competitive Disadvantage}} in {{Stationary Phase}}},
