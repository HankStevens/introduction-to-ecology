  title = {Model \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}election and \{\textbackslash vphantom\}{{M}}\textbackslash vphantom\{\}ultimodel \{\textbackslash vphantom\}{{I}}\textbackslash vphantom\{\}nference: \{\textbackslash vphantom\}{{A}}\textbackslash vphantom\{\} \{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}ractical \{\textbackslash vphantom\}{{I}}\textbackslash vphantom\{\}nformation-\{\textbackslash vphantom\}{{T}}\textbackslash vphantom\{\}heoretic \{\textbackslash vphantom\}{{A}}\textbackslash vphantom\{\}pproach},
