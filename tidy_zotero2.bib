  author = {Tringe, S G and family=Mering, given=C, prefix=von, useprefix=true and Kobayashi, A and Salamov, A A and Chen, K and Chang, H W and Podar, M and Short, J M and Mathur, E J and Detter, J C and Bork, P and Hugenholtz, P and Rubin, E M},
