  author = {Gerwing, J J and Schnitzer, S A and Burnham, R J and Bongers, F and Chave, J and DeWalt, S J and Ewango, C E N and Foster, R and Kenfack, D and Martinez-Ramos, M and Parren, M and Parthasarathy, N and Perez-Salicrup, D R and Putz, F E and Thomas, D W},
