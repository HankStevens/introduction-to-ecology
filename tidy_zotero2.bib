@article{
  title = {Phytoremediation of {{Toxic Elemental}} and {{Organic Pollutants}}},
  author = {Meagher, Richard B.},
  date = {2000},
  journaltitle = {Current Opinion in Plant Biology},
  volume = {3},
  number = {2},
  eprint = {10712958},
  eprinttype = {pubmed},
  pages = {153--162},
  issn = {13695266},
  abstract = {Phytoremediation is the use of plants to extract, sequester, and/or detoxify pollutants. Phytoremediation is widely viewed as the ecologically responsible alternative to the environmentally destructive physical remediation methods currently practiced. Plants have many endogenous genetic, biochemical, and physiological properties that make them ideal agents for soil and water remediation. Significant progress has been made in recent years in developing native or genetically modified plants for the remediation of environmental contaminants. Because elements are immutable, phytoremediation strategies for radionuclide and heavy metal pollutants focus on hyperaccumulation above-ground. In contrast, organic pollutants can potentially be completely mineralized by plants.},
  isbn = {1369-5266}
}

