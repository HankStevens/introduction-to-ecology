@article{
  title = {Effects of {{Ultraviolet Radiation}} on {{Rates}} and {{Size Distribution}} of {{Primary Production}} by \{\textbackslash vphantom\}{{L}}\textbackslash vphantom\{\}ake \{\textbackslash vphantom\}{{E}}\textbackslash vphantom\{\}rie {{Phytoplankton}}},
  author = {Hiriart, Veronique P and Greenberg, Bruce M and Guildford, Stephanie J and Smith, Ralph E H},
  date = {2002},
  journaltitle = {Canadian Journal of Fisheries and Aquatic Sciences},
  volume = {59},
  number = {2},
  pages = {317--328},
  abstract = {The impact of natural solar ultraviolet radiation (UVR), particularly UVB (297-320 nm), on phytoplankton primary production in Lake Erie was investigated during the spring and summer of 1997. Radiocarbon incorporation and size-selective filtration was used to trace total production and its distribution among particulate and dissolved pools. On average, 1-h exposures produced half the UVB-dependent inhibition of total production realized in 8-h exposures, indicating rapid kinetics of photoinhibition. Cumulative UVB-dependent photoinhibition averaged 36\% in 8-h simulated surface exposures. The efficiency of photoinhibition was greater for N-deficient than N-replete communities, but was not related to phytoplankton light history, P limitation, or the dominant genera. The proportion of recently fixed carbon occurring in the dissolved pool after 8-h exposures was significantly greater in higher-UVB treatments, whereas the share in picoplankton ({$<$}2 mum) was significantly lower. Significant UVB-dependent inhibition of total production was limited on average to relatively severe exposures, but the rapid kinetics of inhibition and the apparent effects on the allocation of carbon suggest it may be important to the lake's food web. Differences in optical properties and thermal stratification patterns suggested that the relatively turbid west basin was potentially more susceptible to UVR photoinhibition than the more transparent east or central basins.},
  keywords = {Freshwater Ecology Radiation Biology Algae Microor}
}

