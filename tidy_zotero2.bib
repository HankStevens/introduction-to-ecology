@article{
  title = {Gape-\{\textbackslash vphantom\}{{L}}\textbackslash vphantom\{\}imited \{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}iscivores, \{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}lanktivore \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}ize \{\textbackslash vphantom\}{{R}}\textbackslash vphantom\{\}efuges, and the \{\textbackslash vphantom\}{{T}}\textbackslash vphantom\{\}rophic \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}ascade \{\textbackslash vphantom\}{{H}}\textbackslash vphantom\{\}ypothesis},
  author = {Hambright, K D and Drenner, R W and McComas, S R and Hairston, N G},
  date = {1991},
  journaltitle = {Archiv Fur Hydrobiologie},
  volume = {121},
  number = {4},
  pages = {389--404},
  abstract = {According to the trophic cascade hypothesis, increasing the biomass of piscivorous fish in lakes will reduce the biomass of planktivorous fish, increase zooplankton biomass and reduce phytoplankton biomass. The efficiency of this cascade of effects will depend, in part, on the degree of reduction in planktivore abundance. In this paper, we present 1) a simple model predicting relative vulnerabilities and probabilities of ingestion of different planktivore sizes to piscivory based on planktivore body depths and piscivore mouth widths, 2) an example of the model using populations of four planktivores and two piscivores detailing changes in model predictions with changes in fish morphology, and 3) results from a census of the fish from a small lake, illustrating the potential importance of a prey size refuge in structuring planktivore assemblages. Presence of large, deep-bodied planktivores with low relative vulnerabilities and size refuges from predation may limit the degree of planktivore reduction by gape-limited piscivores and thereby influence the extent to which effects of piscivore manipulations ultimately cascade to lower trophic levels in lakes.},
  keywords = {bass micropterus-salmoides,predator-prey interact}
}

@article{
  title = {Phytoplankton {{Species Diversity Control}} through {{Competitive Exclusion}} and {{Physical Disturbances}}},
  author = {Hambright, K D and Zohary, T},
  date = {2000},
  journaltitle = {Limnology and Oceanography},
  volume = {45},
  number = {1},
  pages = {110--122},
  abstract = {Competitive exclusion theory suggests that phytoplankton species number in an assemblage at equilibrium will be limited to the number of simultaneously limiting resources, generally three or fewer However, natural phytoplankton assemblages usually exhibit high species diversity, hence the concept of Hutchinson's “paradox of the plankton.” Recent works have suggested that this apparent paradox is a result of disturbances intermediate in frequency relative to the time period necessary for species succession to lead to equilibrium conditions (sensu Connell's intermediate disturbance hypothesis [IDH]). Moreover, evidence indicates that disturbances of intermediate intensities are also conducive to maintenance of high species diversity in phytoplankton communities. Using a long-term data record from hypereutrophic subtropical Hartbeespoort Dam (South Africa) that was typically dominated by a single species, but annually subjected to physical disturbance, we demonstrate here that disturbances can indeed enhance phytoplankton species diversity. However these data fail to support Connell's IDH per se, as moderate- and high- intensity disturbances yielded similarly high species diversity. These data also suggest that community resilience (the ability or time to return to predisturbed conditions) is negatively related to disturbance intensity, such that higher intensity disturbances maintained high diversity for longer periods of time relative to lower intensity disturbances.},
  keywords = {hy,lake hartbeespoort dam,microcystis-aeruginosa}
}

