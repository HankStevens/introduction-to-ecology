@article{
  title = {How {{Does}} the 50/500 {{Rule Apply}} to {{MVPs}}?},
  author = {Jamieson, Ian G. and Allendorf, Fred W.},
  date = {2012},
  journaltitle = {Trends in Ecology and Evolution},
  volume = {27},
  number = {10},
  eprint = {22868005},
  eprinttype = {pubmed},
  pages = {580--584},
  publisher = {Elsevier Ltd},
  issn = {01695347},
  abstract = {The 50/500 rule has been used as a guiding principle in conservation for assessing minimum viable effective population size (N e). There is much confusion in the recent literature about how the 500 value should be applied to assess extinction risk and set priorities in conservation biology. Here, we argue that the confusion arises when the genetic basis for a short-term N e of 50 to avoid inbreeding depression is used to justify a long-term N e of 500 to maintain evolutionary potential. This confusion can result in misleading conclusions about how genetic arguments alone are sufficient to set minimum viable population (MVP) thresholds for assessing the extinction risk of threatened species, especially those that emphasize that MVPs should be in the thousands to maintain evolutionary potential. ?? 2012 Elsevier Ltd.},
  isbn = {0169-5347}
}

