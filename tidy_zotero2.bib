@article{
  title = {Habitat {{Destruction}} and the {{Extinction Debt}}},
  author = {Tilman, D and May, R M and Lehman, C L and Nowak, M A},
  date = {1994},
  journaltitle = {Nature},
  volume = {371},
  pages = {65--66},
  abstract = {HABITAT destruction is the major cause of species extinctions(1-3) Dominant species often are considered to be free of this threat because they are abundant in the undisturbed fragments that remain after destruction. Here we describe a model that explains multispecies coexistence in patchy habitats(4) and which predicts that their abundance may be fleeting. Even moderate habitat destruction is predicted to cause time-delayed but deterministic extinction of the dominant competitor in remnant patches. Further species are predicted to become extinct, in order from the best to the poorest competitors, as habitat destruction increases. Moreover, the more fragmented a habitat already is, the greater is the number of extinctions caused by added destruction. Because such extinctions occur generations after fragmentation, they represent a debt-a future ecological cost of current habitat destruction.},
  keywords = {coexistence,competition,disturbance,environment}
}

