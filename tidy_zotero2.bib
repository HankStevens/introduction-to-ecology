@article{
  title = {Induced {{Responses}} to {{Herbivory}} and {{Increased Plant Performance}}},
  author = {Agrawal, A A},
  date = {1998},
  journaltitle = {Science (New York, N.Y.)},
  volume = {279},
  number = {5354},
  pages = {1201--1202},
  abstract = {Plant resistance to herbivores was induced in a field experiment to evaluate the consequences of induced responses for subsequent herbivory and plant fitness. Induction early in the season resulted in halving of herbivory by chewing herbivores and a reduction in the abundance of phloem-feeding aphids when compared with controls. A correlate of lifetime plant fitness, seed mass, was enhanced by over 60 percent for individuals that were induced.}
