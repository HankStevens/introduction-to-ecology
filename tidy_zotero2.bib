@article{
  title = {Biochemical \{\textbackslash vphantom\}{{F}}\textbackslash vphantom\{\}ingerprinting of \{\textbackslash vphantom\}{{W}}\textbackslash vphantom\{\}ater \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}oliform \{\textbackslash vphantom\}{{B}}\textbackslash vphantom\{\}acteria, a \{\textbackslash vphantom\}{{N}}\textbackslash vphantom\{\}ew \{\textbackslash vphantom\}{{M}}\textbackslash vphantom\{\}ethod for \{\textbackslash vphantom\}{{M}}\textbackslash vphantom\{\}easuring \{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}henotypic \{\textbackslash vphantom\}{{D}}\textbackslash vphantom\{\}iversity and for \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}omparing \{\textbackslash vphantom\}{{D}}\textbackslash vphantom\{\}ifferent \{\textbackslash vphantom\}{{B}}\textbackslash vphantom\{\}acterial-\{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}opulations},
