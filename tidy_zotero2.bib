  title = {Loose \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}oupling of \{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}redator-\{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}rey \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}ycles - \{\textbackslash vphantom\}{{E}}\textbackslash vphantom\{\}ntrainment, \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}haos, and \{\textbackslash vphantom\}{{I}}\textbackslash vphantom\{\}ntermittency in the \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}lassic \{\textbackslash vphantom\}{{M}}\textbackslash vphantom\{\}acarthur \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}onsumer-\{\textbackslash vphantom\}{{R}}\textbackslash vphantom\{\}esource \{\textbackslash vphantom\}{{E}}\textbackslash vphantom\{\}quations},
  author = {Vandermeer, J},
  date = {1993},
  journaltitle = {American Naturalist},
  volume = {141},
  number = {5},
  pages = {687--716},
  abstract = {The consumer-resource equations have classically been formulated such that damping is inevitable, an unfortunate restriction since actual systems are known to exhibit permanent oscillations. Modem formulations of a single consumer-resource pair have included conditions that permit limit cycles, but rarely in the connected form originally proposed by MacArthur for the basic consumer-resource system. The purpose of this study was to explore the qualitative behavior of such a connected system. At low levels of connection between the consumer and its nonpreferred resource, the two subsystems rapidly come into phase with one another, thus exhibiting the well-known phenomenon of entrainment. As the level of connectedness increases, the sequence of period doubling is observed that leads to a chaotic attractor. Finally, when the symmetry assumption is relaxed, the system exhibits intermittent chaos, with populations occasionally flushing between long periods of rarity. These general patterns appear to be insensitive to the particular consumer-resource model, depending only on the assumption that both consumer-resource subsystems exhibit limit-cycle-type behavior.},
  keywords = {circadian pacemaker,functional-response,phase-lo}
}

@article{
  title = {The \{\textbackslash vphantom\}{{Q}}\textbackslash vphantom\{\}ualitative \{\textbackslash vphantom\}{{B}}\textbackslash vphantom\{\}ehavior of \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}oupled \{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}redator-\{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}rey \{\textbackslash vphantom\}{{O}}\textbackslash vphantom\{\}scillations as \{\textbackslash vphantom\}{{D}}\textbackslash vphantom\{\}educed from \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}imple \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}ircle \{\textbackslash vphantom\}{{M}}\textbackslash vphantom\{\}aps},
  author = {Vandermeer, J},
  date = {1994},
  journaltitle = {Ecological Modelling},
  volume = {73},
  number = {1--2},
  pages = {135--148},
  abstract = {Qualitative patterns of the non-equilibrium behavior of coupled consumer/resource systems, formulated as a standard circle map, are explored. Patterns of demographic locking, reflected as a ”devil's staircase”, are observed in simulations of the MacArthur consumer/resource equations. As coupling strength increases the steps in the staircase become broader, eventually overlapping to form a chaotic pattern. In addition to the standard form of chaos formation from overlapping Arnold tongues, a pattern of period doubling in the non-invertible standard circle map corresponds to the pattern observed in the classic consumer/resource equations.},
  keywords = {circle map,nonequilibrium behavior,predator prey}
}

@article{
  title = {The \{\textbackslash vphantom\}{{E}}\textbackslash vphantom\{\}cological \{\textbackslash vphantom\}{{B}}\textbackslash vphantom\{\}asis of \{\textbackslash vphantom\}{{A}}\textbackslash vphantom\{\}lternative \{\textbackslash vphantom\}{{A}}\textbackslash vphantom\{\}griculture},
  author = {Vandermeer, J},
  date = {1995},
  journaltitle = {Annual Review of Ecology and Systematics},
  volume = {26},
  pages = {201--224},
  abstract = {The critique of modern agriculture has spawned a host of alternatives, collectively known as the alternative agriculture movement. Its critics have been fierce, its proponents zealous. Making sense of the movement is similar to making sense of the original critique-always eclectic, sometimes contradictory, too often romantic, now and then nonsensical, and occasionally brilliant. This review discusses definitions of the alternative agriculture movement, substitutes for pest control, soil management, integration of all aspects of the farming operation, and the problem of conversion of one form to another.},
  keywords = {agroecosystems,alternative agriculture,sustainab}
}

@article{
  title = {Disturbance and {{Neutral Competition Theory}} in {{Rain Forest Dynamics}}},
  author = {Vandermeer, J},
  date = {1996},
  journaltitle = {Ecological Modelling},
  volume = {85},
  number = {2--3},
  pages = {99--111},
  abstract = {Subsequent to a disturbance in a tropical rain forest, many new stems arrive, either as new seedlings, previously established seedlings, small saplings, newly germinating seeds that were in the seed bank previously, or as newly germinating seeds that arrived after the disturbance. As the new stems grow, they eventually enter a stage of intense competition, at which point competitive thinning occurs. To describe the various patterns this process may take, a theoretical focus is proposed in which the neutrality of competition among different species of rain forest trees is assumed. Using the total biomass and total number of stems as state variables, the dynamic interaction between these two variables in the post hurricane forest is described. Using this model, six distinct patterns of post disturbance succession are recognized and discussed. Data from post hurricane succession in a tropical rain forest in Nicaragua are applied to one aspect of the theory.},
  keywords = {competition,disturbance,interspecific,rain fore}
}

@article{
  title = {Seasonal {{Isochronic Forcing}} of \{\textbackslash vphantom\}{{L}}\textbackslash vphantom\{\}otka \{\textbackslash vphantom\}{{V}}\textbackslash vphantom\{\}olterra {{Equations}}},
  author = {Vandermeer, J},
  date = {1996},
  journaltitle = {Progress of Theoretical Physics},
  volume = {96},
  number = {1},
  pages = {13--28},
  abstract = {Isochronic forcing of a classic Lotka-Volterra system creates subharmonic oscillations of ever greater frequency, interspersed with chaotic attractors that bear the stamp of the limit cycle oscillations in the subharmonic. This pattern emerges from a combination of period doubling bifurcations, saddle node bifurcations, and basin boundary collisions.},
  keywords = {growth,prey}
}

@article{
  title = {A {{Theory}} of {{Disturbance}} and {{Species Diversity}}: \{\textbackslash vphantom\}{{E}}\textbackslash vphantom\{\}vidence from \{\textbackslash vphantom\}{{N}}\textbackslash vphantom\{\}icaragua after \{\textbackslash vphantom\}{{H}}\textbackslash vphantom\{\}urricane \{\textbackslash vphantom\}{{J}}\textbackslash vphantom\{\}oan},
  author = {Vandermeer, J and Boucher, D and Perfecto, I and DelaCerda, I G},
  date = {1996},
  journaltitle = {Biotropica},
  volume = {28},
  number = {4},
  pages = {600--613},
  abstract = {The theory of competition is modified to include the effects of disturbance as a force that can set back the process of competitive exclusion. Disturbance may be of three Forms, density dependent, density independent and quasi-dependent. It is shown analytically that the quasi-dependent form is incapable of setting back the competitive process to avoid competitive exclusion, while either the density dependent form or the density independent form can. The basic theor is tested with data on changes in tree population densities since the landfall of Hurricane Joan in Nicaragua. It is found that this catastrophic event indeed did have the effect of reducing competitive dominance and thus preserving species diversity Furthermore, the effect was density independent.},
  keywords = {disturbance,diversity,hurricane,Nicaragua,rain}
}

@article{
  title = {Syndromes of {{Production}}: {{An Emergent Property}} of {{Simple Agroecosystem Dynamics}}},
  author = {Vandermeer, J},
  date = {1997},
  journaltitle = {Journal of Environmental Management},
  volume = {51},
  number = {1},
  pages = {59--72},
  abstract = {Ecological and economic forces are combined in a model of agroecosystem dynamics. Functions relating (1) cultivation intensity to regional yield, (2) regional yield to unit price, and (3) unit price to cultivation intensity are composed into a single function relating production and/or prices from one time period to another. The combination of ecological and economic dynamics are thus seen as codeterminants of two possible ”syndromes of production” One syndrome includes high product prices, market volatility, ecological decline, high cultivation intensity and low overall supply while the other syndrome includes low prices, stable markets, ecologically benign, low cultivation intensity, and high overall supply. The dynamical consequences of the model include stable points, permanent oscillations and chaos, either in the region of one or the other syndrome or periodically changing from one syndrome to the other. (C) 1997 Academic Press Limited.},
  keywords = {agroecosystems,chaos,one dimensional maps}
}

@article{
  title = {Contrasting {{Growth Rate Patterns}} in {{Eighteen Tree Species}} from a {{Post-Hurricane Forest}} in \{\textbackslash vphantom\}{{N}}\textbackslash vphantom\{\}icaragua},
  author = {Vandermeer, J and DelaCerda, I G and Boucher, D},
  date = {1997},
  journaltitle = {Biotropica},
  volume = {29},
  number = {2},
  pages = {151--161},
  abstract = {Hurricane Joan struck the Caribbean Coast of Nicaragua in October 1988 causing extensive damage ro the lowland rain forest of the zone. Six permanent plots were established in 1990 and the growth rates of all individuals in a total area of 6000 m(2) monitored for six years. Eighteen of the species were abundant enough to measure species-specific growth rates. The post hurricane successional process included a great deal of resprouting of pre-existing individuals and the current stare of the forest includes a low bur very dense canopy, suggesting that competition is entering an intensive phase. Specific growth rates between the rime of the hurricane and the present thus represent establishment or regenerative growth rates and provide an indication of whether or not distinct regeneration niches exist. Three distinct patterns of growth rare seem apparent, fast-growing heliophyles (eight species), slow- growing resprouters (nine species), and Vochysia ferruginea, which seems to have a special pattern.},
  keywords = {lowland rainforest,Nicaragua,niche theory,post-}
}

