@article{
  title = {Preliminary {{Measurements}} of {{Summer Nitric Acid}} and {{Ammonia Concentrations}} in the \{\textbackslash vphantom\}{{L}}\textbackslash vphantom\{\}ake \{\textbackslash vphantom\}{{T}}\textbackslash vphantom\{\}ahoe \{\textbackslash vphantom\}{{B}}\textbackslash vphantom\{\}asin {{Air-Shed}}: \{\textbackslash vphantom\}{{I}}\textbackslash vphantom\{\}mplications for {{Dry Deposition}} of {{Atmospheric Nitrogen}}},
  author = {Tarnay, L and Gertler, A W and Blank, R R and Taylor, G E},
  date = {2001},
  journaltitle = {Environmental Pollution},
  volume = {113},
  number = {2},
  pages = {145--153},
  abstract = {Over the past 50 years, Lake Tahoe, an alpine lake located in the Sierra Nevada mountains on the border between California and Nevada, has seen a decline in water clarity. With significant urbanization within its borders and major urban areas 130 km upwind of the prevailing synoptic airflow, it is believed the Lake Tahoe Basin is receiving substantial nitrogen (N) input via atmospheric deposition during summer and fall. We present preliminary inferential flux estimates to both lake surface and forest canopy based on empirical measurements of ambient nitric acid (HNO3), ammonia (NH3), and ammonium nitrate (NH4NO3) concentrations, in an effort to identify the major contributors to and ranges of atmospheric dry N deposition to the Lake Tahoe Basin. Total flux from dry deposition ranges from 1.2 to 8.6 kg N ha-1 for the summer and fall dry season and is significantly higher than wet deposition, which ranges from 1.7 to 2.9 kg N ha-1 year-1. These preliminary results suggest that dry deposition of HNO3 is the major source of atmospheric N deposition for the Lake Tahoe Basin, and that overall N deposition is similar in magnitude to deposition reported for sites exposed to moderate N pollution in the southern California mountains.},
  keywords = {Biochemistry and Molecular Biophysics Pollution As}
}

