@article{
  title = {Sampling and {{Analysis}} of \{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}olycyclic \{\textbackslash vphantom\}{{A}}\textbackslash vphantom\{\}romatic \{\textbackslash vphantom\}{{H}}\textbackslash vphantom\{\}ydrocarbons (\{\textbackslash vphantom\}{{PAH}}\textbackslash vphantom\{\}) and {{Oxygenated}} \{\textbackslash vphantom\}{{PAH}}\textbackslash vphantom\{\} in {{Diesel Exhaust}} and {{Ambient Air}}},
