@article{
  title = {Living {{Dangerously}} on {{Borrowed Time}} during {{Slow}}, {{Unrecognized Regime Shifts}}},
  author = {Hughes, Terry P. and Linares, Cristina and Dakos, Vasilis and family=Leemput, given=Ingrid A., prefix=van de, useprefix=true and family=Nes, given=Egbert H., prefix=van, useprefix=true},
  date = {2013},
  journaltitle = {Trends in Ecology and Evolution},
  volume = {28},
  number = {3},
  eprint = {22995893},
  eprinttype = {pubmed},
  pages = {149--155},
  publisher = {Elsevier Ltd},
  issn = {01695347},
  abstract = {Regime shifts from one ecological state to another are often portrayed as sudden, dramatic, and difficult to reverse. Yet many regime shifts unfold slowly and imperceptibly after a tipping point has been exceeded, especially at regional and global scales. These long, smooth transitions between equilibrium states are easy to miss, ignore, or deny, confounding management and governance. However, slow responses by ecosystems after transgressing a dangerous threshold also affords borrowed time - a window of opportunity to return to safer conditions before the new state eventually locks in and equilibrates. In this context, the most important challenge is a social one: convincing enough people to confront business-as-usual before time runs out to reverse unwanted regime shifts even after they have already begun. © 2012 Elsevier Ltd.},
  isbn = {0169-5347},
  keywords = {Alternate stable states,Borrowed time,Climate change,Regime shift,Resilience,Slow responses,Thresholds,Transient dynamics}
}

@article{
  title = {Counting the {{Uncountable}} : {{Statistical Approaches}} to {{Estimating Microbial Diversity MINIREVIEW Counting}} the {{Uncountable}} : {{Statistical Approaches}} to {{Estimating Microbial Diversity}}},
  author = {Hughes, Jennifer B and Hellmann, Jessica J and Ricketts, Taylor H and Bohannan, Brendan J M and Sinclair, Lucas and Osman, Omneya Ahmed and Bertilsson, Stefan and Eiler, Alexander and Sala, Vittorio and De Faveri, Eleonora and Li, Chenhao and Lim, Kun Ming Kenneth and Chng, Kern Rei and Nagarajan, Niranjan and Nishida, Satoshi and Ono, Yasuo and Sekimizu, Kazuhisa and Hanning, Irene and Diaz-Sanchez, Sandra and Smith, Let??cia B. and Kasai, Shinji and Scott, Jeffrey G. and Chu, Zhen-Jian and Wang, Yu-Jun and Ying, Sheng-Hua and Wang, Xiao-Wei and Feng, Ming-Guang and Benelli, Giovanni and Lo Iacono, Annalisa and Canale, Angelo and Mehlhorn, Heinz and Aldersley, Andrew and Champneys, Alan and Homer, Martin and Robert, Daniel and Ferguson, Laura V. and Heinrichs, David E. and Sinclair, Brent J. and Ott, Brittany M and Cruciger, Michael and Dacks, Andrew M and Rio, Rita V M and Andreadis, Stefanos S and Michaelakis, Antonios},
  date = {2016},
  journaltitle = {Applied and environmental microbiology},
  volume = {10},
  number = {1},
  eprint = {11571135},
  eprinttype = {pubmed},
  pages = {4399--4406},
  issn = {00992240},
  abstract = {Winter is accompanied by multiple stressors, and the interactions between cold and pathogen stress potentially determine the overwintering success of insects. Thus, it is necessary to explore the thermal performance of the insect immune system. We cold-acclimated spring field crickets, Gryllus veletis, to 6 \textbackslash,° C for 7 days and measured the thermal performance of potential (lysozyme and phenoloxidase activity) and realised (bacterial clearance and melanisation) immune responses. Cold acclimation decreased the critical thermal minimum from -0.5 \textbackslash pm 0.25 to -2.1 \textbackslash pm 0.18 \textbackslash,° C, and chill coma recovery time after 72 h at -2 \textbackslash,° C from 16.8 \textbackslash pm 4.9 to 5.2 \textbackslash pm 2.0 min. Measures of both potential and realised immunity followed a typical thermal performance curve, decreasing with decreasing temperature. However, cold acclimation further decreased realised immunity at low, but not high, temperatures; effectively, immune activity became paradoxically specialised to higher temperatures. Thus, cold acclimation induced mismatched thermal responses between locomotor and immune systems, as well as within the immune system itself. We conclude that cold acclimation in insects appears to preferentially improve cold tolerance over whole-animal immune performance at low temperatures, and that the differential thermal performance of physiological responses to multiple pressures must be considered when predicting ectotherms' response to climate change.},
  isbn = {0099-2240},
  keywords = {Aedes,alive without interfering with,animal species and the,animals,animals are preserved in,Anopheles,Arbovirus,Artesunate,bacteria,biomathematics,biophysics,Biotic stressor,borrelia burgdorferi s,Cold,Cytochrome P450 monooxygenases,Dengue,disease in humans or,Epstein???Barr virus,from which,gastrointestinal tract,immuno-histochemistry,infection,innate immunity,Insecticide resistance,is closely related to,is possible,l,lactic acid bacteria,lactococcus lactis,larvicidal,lyme disease,Malaria,many pathogens which cause,microbial interactions,microbiome,microencapsulated,Mosquito,mosquitoes,Nanosynthesis,oviposition pheromone,pathogen,Pathogen,Plasticity,reservoir function,silkworm,specific biological niches,systems biology,the association between,the survival of,Thermal performance curve,they emerge when transmission,this,ticks,to remain vital and,Tumor biology,Voltage sensitive sodium channel,which must be able,Zika virus}
}

