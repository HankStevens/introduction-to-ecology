@article{
  title = {Nonequilibrium {{Diversity Dynamics}} of the \{\textbackslash vphantom\}{{L}}\textbackslash vphantom\{\}esser \{\textbackslash vphantom\}{{A}}\textbackslash vphantom\{\}ntillean {{Avifauna}}},
