  title = {Soil {{Survey}} of \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}rawford \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}ounty, \{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}ennsylvania / [by \{\textbackslash vphantom\}{{M}}\textbackslash vphantom\{\}ichael \{\textbackslash vphantom\}{{Y}}\textbackslash vphantom\{\}aworski ... et al.]; \{\textbackslash vphantom\}{{U}}\textbackslash vphantom\{\}nited \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}tates \{\textbackslash vphantom\}{{D}}\textbackslash vphantom\{\}epartment of \{\textbackslash vphantom\}{{A}}\textbackslash vphantom\{\}griculture, \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}oil \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}onservation \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}ervice, in {{Cooperation}} with the \{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}ennsylvania \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}tate \{\textbackslash vphantom\}{{U}}\textbackslash vphantom\{\}niversity, \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}ollege of \{\textbackslash vphantom\}{{A}}\textbackslash vphantom\{\}gricu},
