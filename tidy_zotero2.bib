@article{
  title = {On the \{\textbackslash vphantom\}{{R}}\textbackslash vphantom\{\}elationship between \{\textbackslash vphantom\}{{Q}}\textbackslash vphantom\{\}uantitative \{\textbackslash vphantom\}{{G}}\textbackslash vphantom\{\}enetic and \{\textbackslash vphantom\}{{E}}\textbackslash vphantom\{\}ss \{\textbackslash vphantom\}{{M}}\textbackslash vphantom\{\}odels},
  author = {Abrams, P A and Harada, Y and Matsuda, H},
