  title = {Interacting {{Determinants}} of {{Interspecific Relative Growth}}: \{\textbackslash vphantom\}{{E}}\textbackslash vphantom\{\}mpirical {{Patterns}} and a {{Theoretical Explanation}} ({{Vol}} 6, {{Pg}} 289, 1999)},
