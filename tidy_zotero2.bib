  abstract = {A population viability analysis (PVA) was con-\textbackslash textbackslash n\textbackslash textbackslash nducted for a Japanese black bear population in Shimokita\textbackslash textbackslash n\textbackslash textbackslash nPeninsula, northern Japan, using an individual-based simu-\textbackslash textbackslash n\textbackslash textbackslash nlation model. Demographic stochasticity was incorporated\textbackslash textbackslash n\textbackslash textbackslash nin the model as well as the environmental stochasticity from\textbackslash textbackslash n\textbackslash textbackslash nthe fluctuation of annual mast production. The extinction\textbackslash textbackslash n\textbackslash textbackslash nrisk of the population was estimated with an emphasis on\textbackslash textbackslash n\textbackslash textbackslash nthe effect of carrying capacity reduction and hunting pres-\textbackslash textbackslash n\textbackslash textbackslash nsure. The results suggest that the population has a high risk\textbackslash textbackslash n\textbackslash textbackslash nof extinction. Even if there is no further reduction of the\textbackslash textbackslash n\textbackslash textbackslash ncarrying capacity and no hunting at all, the present size of\textbackslash textbackslash n\textbackslash textbackslash nthe population cannot pass the test of the minimum viable\textbackslash textbackslash n\textbackslash textbackslash npopulation size (MVP) concept. Considering possible carry-\textbackslash textbackslash n\textbackslash textbackslash ning capacity reduction in the future and actual hunting pres-\textbackslash textbackslash n\textbackslash textbackslash nsure, the population will fail to survive for 100 years at a\textbackslash textbackslash n\textbackslash textbackslash nvery high probability. Because of deterioration of habitat\textbackslash textbackslash n\textbackslash textbackslash nand loss of the corridor between habitat areas, the popula-\textbackslash textbackslash n\textbackslash textbackslash ntion has become very sensitive to demographic impacts,\textbackslash textbackslash n\textbackslash textbackslash nincluding hunting pressure.},
  issue = {NA},
  keywords = {black bear,Demographic stochasticity,Environmental fluctuation,extinction risk,Individual-based model,minimum viable population size,Population viability analysis,PVA,Simulation}
}

