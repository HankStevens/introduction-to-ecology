@article{
  title = {A {{General Model}} for the {{Structure}} and {{Allometry}} of {{Plant Vascular Systems}}},
  author = {West, G B and Brown, J H and Enquist, B J},
  date = {1999},
  journaltitle = {Nature},
  volume = {400},
