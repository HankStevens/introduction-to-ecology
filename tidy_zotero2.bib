@article{
  title = {An \{\textbackslash vphantom\}{{E}}\textbackslash vphantom\{\}xperimental \{\textbackslash vphantom\}{{F}}\textbackslash vphantom\{\}ield-\{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}tudy of the \{\textbackslash vphantom\}{{E}}\textbackslash vphantom\{\}ffects of \{\textbackslash vphantom\}{{M}}\textbackslash vphantom\{\}ollusk \{\textbackslash vphantom\}{{G}}\textbackslash vphantom\{\}razing on \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}eedling \{\textbackslash vphantom\}{{R}}\textbackslash vphantom\{\}ecruitment and \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}urvival in \{\textbackslash vphantom\}{{G}}\textbackslash vphantom\{\}rassland},
