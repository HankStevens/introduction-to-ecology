  author = {Turunen, Timo and Silvennoinen, Raimo},
  date = {1993},
  journaltitle = {Archiv fuer Hydrobiologie},
  volume = {127},
  number = {4},
  pages = {497--504},
  abstract = {Seasonally changing optical properties of water for Lake Hoytiainen were studied measuring the spectral transmission throughout the year 1991. The spectral distribution of radiation at various levels in the water column was examined by dividing the spectrum into four bands (420 - 500, 480 - 570, 560 - 670 and 750 - 960 nm), in addition to this the photometric (420 - 670 nm) and total values (400 - 960 nm) were measured, too. The transmission of light in water varied greatly during the study period. The dominant wavelengths penetrating deepest in to the water column throughout the year were orange and red as well as green. On the contrary, absorption was strongest at near infrared and blue wavelength regions. Snow cover on the ice had an especially great effect on the diminution of incoming radiation. In early summer radiation penetrated deepest compared with other seasons. In the middle of the summer the absorption caused by algae maximum reduced effectively the light penetration. Towards autumn the absorption of light by water diminished slightly increasing penetration depths of all six wavelength ranges.},
  keywords = {Freshwater Ecology Physiology Radiology Australasi}
}

