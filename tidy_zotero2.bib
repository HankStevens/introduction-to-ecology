@article{
  title = {Impact of {{Clear-Cutting}} and {{Prescribed Burning}} on {{Microbial Diversity}} and {{Community Structure}} in a \{\textbackslash vphantom\}{{J}}\textbackslash vphantom\{\}ack {{Pine}} (\{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}inus {{Banksiana}} \{\textbackslash vphantom\}{{L}}\textbackslash vphantom\{\}amb.) {{Clear-Cut Using}} \{\textbackslash vphantom\}{{B}}\textbackslash vphantom\{\}iolog \{\textbackslash vphantom\}{{G}}\textbackslash vphantom\{\}ram-{{Negative Microplates}}},
