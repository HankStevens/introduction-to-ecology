@article{
  title = {Leaf versus {{Root Nitrogen Uptake}} by the {{Surfgrass}} \{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}hyllospadix {{Torreyi}}},
  author = {Terrados, J and Williams, S L},
  date = {1997},
  journaltitle = {Marine Ecology-Progress Series},
  volume = {149},
  number = {1--3},
  pages = {267--277},
  abstract = {Phyllospadix torreyi S. Watson ('surfgrass') is one of very few seagrass species that grow on rocks. Thus, unlike most other seagrasses, nutrient uptake across leaves rather than across roots might be very important for nutrient acquisition. Ammonium and nitrate+nitrite uptake by surfgrass leaves was measured under flowing water and modelled (Michaelis-Menten) as a function of external concentrations. Leaf NH4+ uptake showed a K-m of 17.4 mu M and a V-max of 125.1 mu mol N g dry wt(-1) h(-1) K-m and V-max values for leaf NO3- + NO2- uptake were 10.1 mu M and 54.5 mu mol N g dry wt(-1) h(-1), respectively. Ammonium available to the roots had little discernible effect on NH4+ uptake by leaves. Low NH4+ uptake rates by roots ({$<$}0.2 mu mol N g dry wt(-1) h(-1)) suggest that surfgrass acquires most of its nitrogen via its leaves.}
}

