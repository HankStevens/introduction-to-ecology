@article{
  title = {European {{Seasonal}} and {{Annual Temperature Variability}}, {{Trends}}, and {{Extremes}} since 1500},
  author = {Luterbacher, J and Dietrich, D and Xoplaki, E and Grosjean, M and Wanner, H},
  date = {2004-03},
