@article{
  title = {A \{\textbackslash vphantom\}{{H}}\textbackslash vphantom\{\}istory of a \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}tunted \{\textbackslash vphantom\}{{B}}\textbackslash vphantom\{\}rook \{\textbackslash vphantom\}{{T}}\textbackslash vphantom\{\}rout \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}alvelinus-\{\textbackslash vphantom\}{{F}}\textbackslash vphantom\{\}ontinalis \{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}opulation in an \{\textbackslash vphantom\}{{A}}\textbackslash vphantom\{\}lpine \{\textbackslash vphantom\}{{L}}\textbackslash vphantom\{\}ake a \{\textbackslash vphantom\}{{L}}\textbackslash vphantom\{\}ife \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}pan of 24 \{\textbackslash vphantom\}{{Y}}\textbackslash vphantom\{\}ears},
  author = {N, Reimers},
  date = {1979},
  journaltitle = {California Fish and Game},
  volume = {65},
  number = {4},
  pages = {196--215},
  abstract = {A history of a stunted brook trout (Salvelinus fontinalis) population in an alpine lake: A lifespan of 24 years.The last known survivor of an experimentally stocked population of brook trout lived well into its 24th yr of life in a small, High Sierra [California, USA] lake. This extreme longevity doubles previous age records for the species and is attributed to a combination of food scarcity, low temperature and a remote environment where the influence of angling was negligible. As a consequence of early overcropping and decimation of invertebrate food organisms, semistarvation and stunting continued throughout the lives of originally stocked trout. Natural propagation was repressed until age 16 yr. Growth was near normal for the few second-generation fish, which arrived late enough to inherit improved forage due to attrition of the parent generation. Laboratory culture of some of the aging trout (12-18 yr) demonstrated capacity for regrowth with sustained nutrition. A breeding experiment with 14-yr-olds produced no viable offspring, but cross-fertilization with young brook trout indicated limited fertility in both sexes at advanced age. Histological evaluations at ages 12, 13, 14 and 18 yr sought to correlate degenerative changes in vital systems with chronological age. Old trout were distinguishable from their young counterparts only by minor, wear-and-tear changes until very late in life. Gross developmental anomalies were found in generative cells and tissues of nearly all mature specimens examined, but could not be definitely linked to physiological aging. Fin-clipped individuals permitted identification of the stocked group for 19 yr. Otoliths were used to verify ages up to 24 yr.}
}

@article{
  title = {Insertion \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}equence-\{\textbackslash vphantom\}{{R}}\textbackslash vphantom\{\}elated \{\textbackslash vphantom\}{{G}}\textbackslash vphantom\{\}enetic-\{\textbackslash vphantom\}{{V}}\textbackslash vphantom\{\}ariation in \{\textbackslash vphantom\}{{R}}\textbackslash vphantom\{\}esting \{\textbackslash vphantom\}{{E}}\textbackslash vphantom\{\}scherichia-\{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}oli \{\textbackslash vphantom\}{{K}}\textbackslash vphantom\{\}-12},
  author = {Naas, T and Blot, M and Fitch, W M and Arber, W},
  date = {1994},
  journaltitle = {Genetics},
  volume = {136},
  number = {3},
  pages = {721--730},
  abstract = {Bacterial subclones recovered from an old stab culture of Escherichia coli K-12 revealed a high degree of genetic diversity, which occurred in spite of a very reduced rate of propagation during storage. This conclusion is based on a pronounced restriction fragment length polymorphism (RFLP) detected upon hybridization with internal fragments of eight resident insertion sequences (IS). Genetic diversity was dependent on the IS considered and, in many cases, a clear consequence of IS transposition. IS5 was particularly active in the generation of variation. All subclones in which IS30 had been active testify to a burst of IS30 transposition. This was correlated with a loss of prototrophy and a reduced growth on rich media. A pedigree of the entire clone could be drawn from the RFLP patterns of the subclones. Out of 118 subclones analyzed, 68 different patterns were found but the putative ancestral population had disappeared. A few patterns were each represented by several subclones displaying improved fitness. These results offer insights into the role of IS elements in the plasticity of the E. coli genome, and they further document that enzyme-mediated DNA rearrangements do occur in resting bacterial cultures.},
  keywords = {nucleotide-sequence,spontan,transposable element}
}

