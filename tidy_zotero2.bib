@article{
  title = {Evolution of \{\textbackslash vphantom\}{{B}}\textbackslash vphantom\{\}rassica {{Rapa}} \{\textbackslash vphantom\}{{L}}\textbackslash vphantom\{\} (\{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}ruciferae) {{Populations}} in {{Intra-}} and {{Interspecific Competition}}},
