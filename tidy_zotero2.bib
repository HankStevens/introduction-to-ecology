  title = {A \{\textbackslash vphantom\}{{B}}\textbackslash vphantom\{\}road \{\textbackslash vphantom\}{{E}}\textbackslash vphantom\{\}valuation of \{\textbackslash vphantom\}{{B}}\textbackslash vphantom\{\}ti for \{\textbackslash vphantom\}{{B}}\textbackslash vphantom\{\}lack \{\textbackslash vphantom\}{{F}}\textbackslash vphantom\{\}ly (\{\textbackslash vphantom\}{{D}}\textbackslash vphantom\{\}iptera, \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}imuliidae) \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}ontrol in a \{\textbackslash vphantom\}{{M}}\textbackslash vphantom\{\}ichigan \{\textbackslash vphantom\}{{R}}\textbackslash vphantom\{\}iver - \{\textbackslash vphantom\}{{E}}\textbackslash vphantom\{\}fficacy, \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}arry and \{\textbackslash vphantom\}{{N}}\textbackslash vphantom\{\}ontarget \{\textbackslash vphantom\}{{E}}\textbackslash vphantom\{\}ffects on \{\textbackslash vphantom\}{{I}}\textbackslash vphantom\{\}nvertebrates and \{\textbackslash vphantom\}{{F}}\textbackslash vphantom\{\}ish},
