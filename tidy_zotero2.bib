  title = {Three-\{\textbackslash vphantom\}{{G}}\textbackslash vphantom\{\}orges \{\textbackslash vphantom\}{{D}}\textbackslash vphantom\{\}am - \{\textbackslash vphantom\}{{E}}\textbackslash vphantom\{\}xperiment in {{Habitat Fragmentation}}?},
