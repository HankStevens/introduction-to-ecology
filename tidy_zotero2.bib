@article{
  title = {Stability of \{\textbackslash vphantom\}{{V}}\textbackslash vphantom\{\}ertices in \{\textbackslash vphantom\}{{R}}\textbackslash vphantom\{\}andom \{\textbackslash vphantom\}{{B}}\textbackslash vphantom\{\}oolean \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}ellular \{\textbackslash vphantom\}{{A}}\textbackslash vphantom\{\}utomata},
  author = {Luczak, T and Cohen, J E},
  date = {1991},
  journaltitle = {Random Structures \& Algorithms},
  volume = {2},
  number = {3},
  pages = {327--334},
  abstract = {Based on computer simulations, Kauffman (Physica D, 10, 145- 156, 1984) made several generalizations about a random Boolean cellular automation which he invented as a model of cellular metabolism. Here we give the first rigorous proofs of two of Kauffman's generalizations: a large fraction of vertices stabilize quickly, consequently the length of cycles in the automaton's behavior is small compared to that of a random mapping with the same number of states; and reversal of the states of a large fraction of the vertices does not affect the cycle to which the automaton moves.},
  keywords = {networks}
}

@article{
  title = {Giant \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}omponents in 3-\{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}arameter \{\textbackslash vphantom\}{{R}}\textbackslash vphantom\{\}andom \{\textbackslash vphantom\}{{D}}\textbackslash vphantom\{\}irected-\{\textbackslash vphantom\}{{G}}\textbackslash vphantom\{\}raphs},
  author = {Luczak, T and Cohen, J E},
  date = {1992},
  journaltitle = {Advances in Applied Probability},
  volume = {24},
  number = {4},
  pages = {845--857},
  abstract = {A three-parameter model of a random directed graph (digraph) is specified by the probability of 'up arrows' from vertex i to vertex j where i {$<$} j, the probability of 'down arrows' from i to j where i {$>$} j, and the probability of bidirectional arrows between i and j. In this model, a phase transition-the abrupt appearance of a giant strongly connected component-takes place as the parameters cross a critical surface. The critical surface is determined explicitly. Before the giant component appears, almost surely all non-trivial components are small cycles. The asymptotic probability that the digraph contains no cycles of length 3 or more is computed explicitly. This model and its analysis are motivated by the theory of food webs in ecology.},
  keywords = {acyclic random digraphs,phase transition,random}
}

