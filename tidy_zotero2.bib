@article{
  title = {Endangered {{Species Recovery}} and the \{\textbackslash vphantom\}{{SCB}}\textbackslash vphantom\{\} {{Study}}: \{\textbackslash vphantom\}{{A}}\textbackslash vphantom\{\} \{\textbackslash vphantom\}{{US}}\textbackslash vphantom\{\} \{\textbackslash vphantom\}{{F}}\textbackslash vphantom\{\}ish and \{\textbackslash vphantom\}{{W}}\textbackslash vphantom\{\}ildlife \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}ervice {{Perspective}}},
  author = {Crouse, D T and Mehrhoff, L A and Parkin, M J and Elam, D R and Chen, L Y},
  date = {2002},
  journaltitle = {Ecological Applications},
  volume = {12},
  number = {3},
  pages = {719--723},
  abstract = {As agency biologists with snore than 30 years of collective recovery experience, we provide our perspective on the endangered species recovery planning process and the Society for Conservation Biology (SCB) recovery planning study. As part of the continuum from listing through recovery planning and implementation to species recovery and delisting, we believe that clearly written, well-designed recovery plans can play a key role in organizing and focusing the recovery effort for endangered and threatened species. We outline major opportunities, constraints, and limitations of the recovery planning process. Next we discuss some of the major results and recommendations of the SCB recovery plan study and identify 10 action items for further U.S. Fish and Wildlife Service consideration as possible ways to strengthen our recovery program for endangered and threatened species.},
  keywords = {action plans,Endangered Speci,endangered species}
}

