  title = {Global \{\textbackslash vphantom\}{{M}}\textbackslash vphantom\{\}arine \{\textbackslash vphantom\}{{B}}\textbackslash vphantom\{\}iological \{\textbackslash vphantom\}{{D}}\textbackslash vphantom\{\}iversity - a \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}trategy for \{\textbackslash vphantom\}{{B}}\textbackslash vphantom\{\}uilding \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}onservation into \{\textbackslash vphantom\}{{D}}\textbackslash vphantom\{\}ecision-\{\textbackslash vphantom\}{{M}}\textbackslash vphantom\{\}aking - \{\textbackslash vphantom\}{{N}}\textbackslash vphantom\{\}orse,\{\textbackslash vphantom\}{{E}}\textbackslash vphantom\{\}a},
