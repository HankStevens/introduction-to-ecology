@article{
  title = {Beneficial {{Biofuels}}–{{The Food}}, {{Energy}}, and {{Environment Trilemma}}},
  author = {Tilman, D. and Socolow, R. and Foley, J. A. and Hill, J. and Larson, E. and Lynd, L. and Pacala, S. and Reilly, J. and Searchinger, T. and Somerville, C. and Williams, R.},
