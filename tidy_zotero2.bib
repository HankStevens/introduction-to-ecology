@article{
  title = {Genotyping-by-{{Sequencing}} in {{Ecological}} and {{Conservation Genomics}}},
  author = {NARUM, SHAWN R. and BUERKLE, C. ALEX and DAVEY, JOHN W. and MILLER, MICHAEL R. and HOHENLOHE**, PAUL A.},
  date = {2010},
  journaltitle = {Molecular Ecology},
  volume = {22},
