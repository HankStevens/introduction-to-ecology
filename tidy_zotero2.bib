@article{
  title = {Population {{Dynamics}} and {{Genetics}} of {{Plant Disease}}: {{A Case Study}} of {{Anther-Smut Disease}}},
  author = {Alexander, H M and Thrall, P H and Antonovics, J and Jarosz, A M and Oudemans, P V},
  date = {1996-06},
  journaltitle = {ECOLOGY},
  volume = {77},
  number = {4},
  pages = {990--996},
  issn = {0012-9658},
  abstract = {A model by Levin and Udovic (1977) emphasizes the need for integration of studies of the numerical abundances and genetic composition of host and pathogen species. We use their conceptual framework to summarize our collaborative research on the ecological genetics of the anther-smut disease of Silene alba caused by the fungus Ustilago violacea. Our theoretical investigations have revealed the importance of the rate and mode of disease transmission on the likelihood of coexistence between host and pathogen. Our empirical studies have quantified patterns of disease spread on local and regional spatial scales and have shown that host genotypes differ greatly in resistance. Comparable genetic variation in pathogen virulence has not yet been demonstrated. The genetic composition of host populations alters numerical dynamics in experimental populations: disease declines in resistant populations, while host and pathogen appear to coexist in susceptible populations. Ecological outcomes also may be affected by the negative relationship between disease incidence and host flowering time, which may constitute a `'cost” to resistance. We are currently expanding our work on the ecology and genetics of metapopulation dynamics of host and pathogen.},
  keywords = {anther-smut,coexistence,disease ecology,host,p}
}

