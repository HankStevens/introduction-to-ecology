@article{
  title = {Influence of {{Land Use}} and {{Landscape Setting}} on the {{Ecological Status}} of {{Rivers}}},
  author = {Allan, J. David},
  date = {2004},
  journaltitle = {Limnetica},
  volume = {23},
  number = {3--4},
  eprint = {68},
  eprinttype = {pubmed},
  pages = {187--198},
  issn = {02138409},
  abstract = {Allan, J. D. (2004). Influence of land use and landscape setting on the ecological status of rivers. In Limnetica (Vol. 23, pp. 187-197). There has been great growth in research regarding the linear and nonlinear relationships between land use variables and river condition as a result of the development of geographic information systems, Bioassessment tools, and the advent of the field of landscape ecology and spatial statistics. Linking rivers to the landscapes around them improves our understanding of the anthropocentric effects such as channel modifications, urbanization, forest management practices, mining and recreation. Responses to these effects can include nutrient enrichment, habitat deterioration, sedimentation, contamination, altered flow regimes, and non-indigenous species introduction. The catchment approach to managing the river ecosystem for these effects is structured around identifying a land-water unit, assessing the health of the river, identifying the stressors that are influencing the health status, and developing management plans. Challenges to this approach lie within the linear and non-linear responses to alteration, legacy effects, spatial scale issues, complexities of multiple interacting stressors, covariance of natural and anthropocentric gradients and diagnosing the cause of an issue. Future research, however, will continue to combine statistical associations between land use and river heath with previous understandings of human influence and will allow for development of more scientifically grounded management plans.},
  isbn = {1543-592X},
  keywords = {Biological assessment,Catchment,Land use,Streams,Watershed}
}

@article{
  title = {The {{Negative Impact}} of {{Aging}} on the {{Loss}} of \{\textbackslash vphantom\}{{PAH}}\textbackslash vphantom\{\} {{Components}} in a {{Creosote-Contaminated Soil}}},
  author = {Allard, A S and Remberger, M and Neilson, A H},
  date = {2000},
  journaltitle = {International Biodeterioration \& Biodegradation},
  volume = {46},
  number = {1},
  pages = {43--49},
  abstract = {Soil samples were collected from sites contaminated with creosote but differing in the length of time since cessation of production. They were used to evaluate in laboratory experiments the effect of aging and the significance of adding metabolically competent bacteria on the loss of indigenous fluoranthene and perylene. Incubation was carried out with or without addition of cells grown with 3-methylbenzoate. Control experiments used spiked contaminants to confirm the metabolic competence of the added bacteria, and azide was used to exclude the role of abiotic reactions. It was concluded that there was no advantage in adding metabolically competent bacteria to facilitate degradation of these PAH contaminants in soil, and that aging was a primary factor in determining the success of bioremediation. Indigenous benzo[e]phenanthrylene, benzo[ ghi]perlylene. and benzo[a]pyrene were recalcitrant in the younger soil; and in view of the results for fluoranthene and pyrene. they may. therefore, be presumed to be recalcitrant in aged soils. (C) 2000 Elsevier Science Ltd. All rights reserved .},
  keywords = {aging,bacteria,creosote-contaminated soil,loss}
}

