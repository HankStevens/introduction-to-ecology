@article{
  title = {Biodegradation of {{Wastewater}} of \{\textbackslash vphantom\}{{N}}\textbackslash vphantom\{\}ajafgarh {{Drain}}, \{\textbackslash vphantom\}{{D}}\textbackslash vphantom\{\}elhi {{Using Autochthonous Microbial Consortia}} : \{\textbackslash vphantom\}{{A}}\textbackslash vphantom\{\} {{Laboratory Study}}},
  author = {Sharma, G and Mehra, N K and Kumar, R},
