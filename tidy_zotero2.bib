@article{
  title = {Northern {{Geometrid Forest Pests}} ({{Lepidoptera}}: {{Geometridae}}) {{Hatch}} at {{Lower Temperatures}} than {{Their Southern Conspecifics}}: {{Implications}} of {{Climate Change}}},
  author = {Falt-Nardmann, Julia and Klemola, Tero and Roth, Mechthild and Ruohomaki, Kai and Saikkonen, Kari},
  date = {2016},
  journaltitle = {European Journal of Entomology},
  volume = {113},
  pages = {337--343},
  issn = {1802-8829},
  abstract = {Climate change may facilitate shifts in the ranges and the spread of\textbackslash textbackslash ninsect pests, but a warming climate may also affect herbivorous insects\textbackslash textbackslash nadversely if it disrupts the locally adapted synchrony between the\textbackslash textbackslash nphenology of insects and that of their host plant. The ability of a pest\textbackslash textbackslash nspecies to colonize new areas depends on its ability to adjust the\textbackslash textbackslash ntiming of phenological events in its life cycle, particularly at high\textbackslash textbackslash nlatitudes where there is marked seasonality in temperature and day\textbackslash textbackslash nlength. Here we incubated eggs of three species of geometrid moth,\textbackslash textbackslash nEpirrita autumnata, Operophtera brumata and Erannis defoliaria from\textbackslash textbackslash ndifferent geographical populations (E. autumnata and O. brumata from\textbackslash textbackslash nNorthern Finland, E. autumnata and E. defoliaria from Southern Finland\textbackslash textbackslash nand all three species from Germany) in a climate chamber at a constant\textbackslash textbackslash ntemperature to determine the relative importance of geographic origin in\textbackslash textbackslash nthe timing of egg hatch measured in terms of cumulative temperature sums\textbackslash textbackslash n(degree days above 5 degrees C, DD5); i.e. the relative importance of\textbackslash textbackslash nlocal adaptation versus phenotypic plasticity in the timing of egg\textbackslash textbackslash nhatch. In all three species, eggs from northern populations required a\textbackslash textbackslash nsignificantly lower temperature sum for hatching than eggs from southern\textbackslash textbackslash npopulations, but the differences between them in temperature sum\textbackslash textbackslash nrequirements varied considerably among species, with the differences\textbackslash textbackslash nbeing largest for the earliest hatching and northernmost species, E.\textbackslash textbackslash nautumnata, and smallest for the southern, late-hatching E. defoliaria.\textbackslash textbackslash nIn addition, the difference in hatch timing between the E. autumnata\textbackslash textbackslash neggs from Southern Finland and Germany was many times greater than the\textbackslash textbackslash ndifference between the two Finnish populations of E. autumnata, despite\textbackslash textbackslash nthe fact that the geographical distances between these populations is\textbackslash textbackslash nsimilar. We discuss how these differences in hatching time may be\textbackslash textbackslash nexplained by the differences in hatch-budburst synchrony and its\textbackslash textbackslash nimportance for different moth species and populations. We also briefly\textbackslash textbackslash nreflect on the significance of photoperiod, which is not affected by\textbackslash textbackslash nclimate change. It is a controller that works parallel or in addition to\textbackslash textbackslash ntemperature sum both for egg hatch in moths and bud burst of their host\textbackslash textbackslash nplants.},
  issue = {April},
  keywords = {Epirrita autumnata,Eran,Geometridae,Lepidoptera}
}

@article{
  title = {A {{Large Terrestrial Carbon Sink}} in {{North America Implied}} by {{Atmospheric}} and {{Oceanic Carbon Dioxide Data}} and {{Models}}},
  author = {Fan, S.},
  date = {1998},
  journaltitle = {Science (New York, N.Y.)},
  volume = {282},
  number = {5388},
  eprint = {9774264},
  eprinttype = {pubmed},
  pages = {442--446},
  issn = {1095-9203},
  abstract = {Atmospheric carbon dioxide increased at a rate of 2.8 petagrams of carbon per year (Pg C year-1) during 1988 to 1992 (1 Pg = 10(15) grams). Given estimates of fossil carbon dioxide emissions, and net oceanic uptake, this implies a global terrestrial uptake of 1.0 to 2. 2 Pg C year-1. The spatial distribution of the terrestrial carbon dioxide uptake is estimated by means of the observed spatial patterns of the greatly increased atmospheric carbon dioxide data set available from 1988 onward, together with two atmospheric transport models, two estimates of the sea-air flux, and an estimate of the spatial distribution of fossil carbon dioxide emissions. North America is the best constrained continent, with a mean uptake of 1.7 +/- 0.5 Pg C year-1, mostly south of 51 degrees north. Eurasia-North Africa is relatively weakly constrained, with a mean uptake of 0.1 +/- 0.6 Pg C year-1. The rest of the world's land surface is poorly constrained, with a mean source of 0.2 +/- 0.9 Pg C year-1.},
  isbn = {0036-8075}
}

