  author = {Thomas, C D and Williams, S E and Cameron, A and Green, R E and Bakkenes, M and Beaumont, L J and Collingham, Y C and Erasmus, B F N and family=Siqueira, given=M F, prefix=de, useprefix=true and Grainger, A and Hannah, L and Hughes, L and Huntley, B and family=Jaarsveld, given=A S, prefix=van, useprefix=true and Midgley, G F and Miles, L and Ortega-Huerta, M A and Peterson, A T and Phillips, O L},
