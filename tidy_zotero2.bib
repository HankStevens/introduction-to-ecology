@article{
  title = {Do {{Neighboring Lakes Share Common Taxa}} of {{Bacterioplankton}}? \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}omparison of 16\{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\} r\{\textbackslash vphantom\}{{DNA}}\textbackslash vphantom\{\} {{Fingerprints}} and {{Sequences}} from {{Three Geographic Regions}}},
