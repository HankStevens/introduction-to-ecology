  date = {1996},
  journaltitle = {Environmental Health Perspectives},
  volume = {104},
  number = {11},
  pages = {1166--1170},
  abstract = {Various substances and industrial processes, surrogates of exposure to polycyclic aromatic hydrocarbons (PAHs), are currently classified as human carcinogens. This paper reviews recent epidemiological studies reporting direct evidence of the carcinogenic effects of PAHs in occupationally exposed subjects. Risks of lung and bladder cancer were dose dependent when PAHs were measured quantitatively and truly nonexposed groups were chosen for comparison. These new findings suggest that the current threshold limit value of 0.2 mg/m(3) of benzene soluble matter (which indicates PAH exposure) is unacceptable because, after 40 years of exposure, it involves a relative risk of 1.2-1.4 for lung cancer and 2.2 for bladder cancer.},
