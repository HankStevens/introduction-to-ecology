@article{
  title = {Direct and {{Indirect Relationships}} between {{Specific Leaf Area}}, {{Leaf Nitrogen}} and {{Leaf Gas Exchange}}. {{Effects}} of {{Irradiance}} and {{Nutrient Supply}}},
  author = {Meziane, D},
  date = {2001},
  journaltitle = {Annals of Botany},
  volume = {88},
  number = {5},
  eprint = {172101400012},
  eprinttype = {pubmed},
  pages = {915--927},
  issn = {03057364},
  abstract = {We present a series of competing path models relating interspecific patterns between specific leaf area, leaf nitrogen content, net photosynthesis and stomatal conductance and test these against data from 22 species of herbaceous plants grown under controlled conditions with contrasting irradiance and nutrient supply rates. We then compare these results with two previous data sets, one based on field measures and one based on glasshouse measures, to determine the robustness of the results. Only one model was able to account for the patterns of direct and indirect effects between the four variables to all data sets. In this model specific leaf area is the forcing variable that directly affects both leaf nitrogen levels and net photosynthetic rates. Leaf nitrogen then directly affects net photosynthetic rates which in turn then affect stomatal conductance to water. (C) 2001 Annals of Botany Company.},
  isbn = {0305-7364},
  keywords = {c leaf area,changes in,comparative ecology,d u c t,evaluate the robustness to,i n t ro,i o n,in this study we,modelling,path analysis,photosynthesis,plant strategies,sla,speci,stomatal conductance}
}

@article{
  title = {Record-{{Setting Algal Bloom}} in {{Lake Erie Caused}} by {{Agricultural}} and {{Meteorological Trends Consistent}} with {{Expected Future Conditions}}},
  author = {Michalak, A. M. and Anderson, E. J. and Beletsky, D. and Boland, S. and Bosch, N. S. and Bridgeman, T. B. and Chaffin, J. D. and Cho, K. and Confesor, R. and Daloglu, I. and DePinto, J. V. and Evans, M. A. and Fahnenstiel, G. L. and He, L. and Ho, J. C. and Jenkins, L. and Johengen, T. H. and Kuo, K. C. and LaPorte, E. and Liu, X. and McWilliams, M. R. and Moore, M. R. and Posselt, D. J. and Richards, R. P. and Scavia, D. and Steiner, A. L. and Verhamme, E. and Wright, D. M. and Zagorski, M. A.},
  date = {2013},
  journaltitle = {Proceedings of the National Academy of Sciences},
  volume = {110},
  number = {16},
  eprint = {23576718},
  eprinttype = {pubmed},
  pages = {6448--6452},
  issn = {0027-8424},
  abstract = {In 2011, Lake Erie experienced the largest harmful algal bloom in its recorded history, with a peak intensity over three times greater than any previously observed bloom. Here we show that long-term trends in agricultural practices are consistent with increasing phosphorus loading to the western basin of the lake, and that these trends, coupled with meteorological conditions in spring 2011, produced record-breaking nutrient loads. An extended period of weak lake circulation then led to abnormally long residence times that incubated the bloom, and warm and quiescent conditions after bloom onset allowed algae to remain near the top of the water column and prevented flushing of nutrients from the system. We further find that all of these factors are consistent with expected future conditions. If a scientifically guided management plan to mitigate these impacts is not implemented, we can therefore expect this bloom to be a harbinger of future blooms in Lake Erie.},
  isbn = {0027-8424}
}

