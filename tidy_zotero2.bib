  volume = {95},
  pages = {90--94},
  abstract = {Used Ellenberg values to assess productivity levels. Found that seed mass was higher in more productive environments, resulting in lower seed output. At higher seed mass, seeds were more likely to have a "dispersal syndrome". The result could explain the hump-back relationship between diversity and productivity.},
