@article{
  title = {North \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}iberian {{Lakes}}: \{\textbackslash vphantom\}{{A}}\textbackslash vphantom\{\} {{Methane Source Fueled}} by \{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}leistocene {{Carbon}}},
  author = {Zimov, S A and Voropaev, Y V and Semiletov, I P and Davidov, S P and Prosiannikov, S F and Chapin, F S and Chapin, M C and Trumbore, S and Tyler, S},
  date = {1997},
  journaltitle = {Science (New York, N.Y.)},
  volume = {277},
  number = {5327},
  pages = {800--802},
  abstract = {The sizes of major sources and sinks of atmospheric methane (CH4), an important greenhouse gas, are poorly known, CH4 from north Siberian lakes contributes similar to 1.5 teragrams CH4 year(-1) to observed winter increases in atmospheric CH4 concentration at high northern latitudes, CH4 emitted from these lakes in winter had a radiocarbon age of 27,200 years and was derived largely from Pleistocene-aged carbon.}
