  title = {Fine-\{\textbackslash vphantom\}{{R}}\textbackslash vphantom\{\}oot \{\textbackslash vphantom\}{{B}}\textbackslash vphantom\{\}iomass and \{\textbackslash vphantom\}{{N}}\textbackslash vphantom\{\}utrient \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}ycling in \{\textbackslash vphantom\}{{A}}\textbackslash vphantom\{\}ristida-\{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}tricta in a \{\textbackslash vphantom\}{{N}}\textbackslash vphantom\{\}orth-\{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}arolina \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}oastal-\{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}lain \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}avanna},
