@article{
  title = {Statistical {{Approaches}} for {{Analyzing Mutational Spectra}}: \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}ome {{Recommendations}} for {{Categorical Data}}},
  author = {Piegorsch, Walter W and Bailer, A John},
  date = {1994},
  journaltitle = {Genetics},
  volume = {136},
  number = {1},
  pages = {403--416},
  abstract = {In studies examining the patterns or spectra of mutational damage, the primary variables of interest are expressed typically as discrete counts within defined categories of damage. Various statistical methods can be applied to test for heterogeneity among the observed spectra of different classes, treatment groups and/or doses of a mutagen. These are described and compared via computer simulations to determine which are most appropriate for practical use in the evaluation of spectral data. Our results suggest that selected, simple modifications of the usual Pearson X-2 statistic for contingency tables provide stable false positive error rates near the usual alpha = 0.05 level and also acceptable sensitivity to detect differences among spectra. Extensions to the problem of identifying individual differences within and among mutant spectra are noted.},
  keywords = {Genetics Mathematical Biology Models and Simulatio}
}

