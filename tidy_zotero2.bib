@article{
  title = {Uptake of \{\textbackslash vphantom\}{{D}}\textbackslash vphantom\{\}issolved and \{\textbackslash vphantom\}{{O}}\textbackslash vphantom\{\}il \{\textbackslash vphantom\}{{P}}\textbackslash vphantom\{\}hase \{\textbackslash vphantom\}{{O}}\textbackslash vphantom\{\}rganic-\{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}hemicals by \{\textbackslash vphantom\}{{B}}\textbackslash vphantom\{\}acteria},
