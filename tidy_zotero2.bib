  title = {The {{Tropical Pacifi}} c {{Ocean}} —},
  author = {Gomer, R and Mullins, W W and Fakhraai, Z and Forrest, J A and Keddie, J L and Jones, R A L and Cory, R A and Baschnagel, J and Varnik, F and Hutcheson, S A and Mckenna, G B and Hamdorf, M and Johannsmann, D and Tsui, O K C and Peng, D}
