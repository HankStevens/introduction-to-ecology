@article{
  title = {Evaluating the {{Biotic Integrity}} of {{Watersheds}} in the \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}ierra \{\textbackslash vphantom\}{{N}}\textbackslash vphantom\{\}evada, \{\textbackslash vphantom\}{{C}}\textbackslash vphantom\{\}alifornia},
  author = {Moyle, Peter B and Randall, Paul J},
