@article{
  title = {Extending {{Nondirectional Heterogeneity Tests}} to {{Evaluate Simply Ordered Alternative Hypotheses}}.},
  author = {Rice, W R and Gaines, S D},
  date = {1994},
  journaltitle = {Proceedings of the National Academy of Sciences of the United States of America},
  volume = {91},
  number = {1},
