  keywords = {biogeochemical dynamics,dynamics,ecosystem,ecosystem model,indi-,moment approximation,plant community dynamics,scaling,seen remarkable progress in,size- and age-struc-,south america,sub-grid scale heterogeneity,terrestrial,terrestrial biosphere model,the,the past decade has,tured,vegetation dynamics,vidual-based model}
