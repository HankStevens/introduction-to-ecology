  author = {Masson-Delmotte, V and Jouzel, J and Landais, A and Stievenard, M and Johnsen, S J and White, J W C and Werner, M and Sveinbjornsdottir, A and Fuhrer, K},
  date = {2005-07},
  journaltitle = {Science (New York, N.Y.)},
  volume = {309},
  number = {5731},
  pages = {118--121},
  abstract = {The Northern Hemisphere hydrological cycle is a key factor coupling ice sheets, ocean circulation, and polar amplification of climate change. Here we present a Northern Hemisphere deuterium excess profile covering one climatic cycle, constructed with the use of delta(18)O and delta D Greenland Ice Core Project (GRIP) records. Past changes in Greenland source and site temperatures are quantified with precipitation seasonality taken into account. The imprint of obliquity is evidenced in the site-to-source temperature gradient at orbital scale. At the millennial. time scale, GRIP source temperature changes reflect southward shifts of the geographical locations of moisture sources during cold events, and these rapid shifts are associated with large-scale changes in atmospheric circulation.},
  keywords = {ABRUPT CLIMATE-CHANGE,LAST,NORTH-ATLANTIC OCEAN}
}

