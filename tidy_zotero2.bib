@article{
  title = {Enrichment and {{Isolation}} of {{Non-Specific Aromatic Degraders}} from {{Unique Uncontaminated}} ({{Plant}} and {{Faecal Material}}) {{Sources}} and {{Contaminated Soils}}},
  author = {Juhasz, A L and Naidu, R},
