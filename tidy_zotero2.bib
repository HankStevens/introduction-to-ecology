@article{
  title = {Expression of {{Growth Hormone Gene}} in the {{Head Kidney}} of {{Gilthead Sea Bream}} (\{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}parus {{Aurata}})},
  author = {Calduch-Giner, Josep A and Perez-Sanchez, Jaume},
  date = {1999},
  journaltitle = {Journal of Experimental Zoology},
  volume = {283},
  number = {3},
  pages = {326--330},
  abstract = {The presence of growth hormone (GH) mRNA in the head kidney of gilthead sea bream (Sparus aurata) was assessed by reverse transcription and polymerase chain reaction (RTPCR). Reverse transcription was made with oligo-dT primers, and a single cDNA band (435 bp) corresponding in length to the distance between two specific GH primers was obtained. No corresponding product was seen using liver and brain RNA samples. The amplified DNA hybridized specifically with a pituitary GH probe after Southern transfer to nylon membranes. The identity of this DNA fragment was further confirmed by sequencing a nested PCR product (343 bp). This finding supports the hypothesis that the immune system in both higher and lower vertebrates is an extrapituitary site for the expression of GH, which may serve as an autocrine/paracrine factor immunomodulation.},
  keywords = {Endocrine System Immune System Molecular Genetics}
}

