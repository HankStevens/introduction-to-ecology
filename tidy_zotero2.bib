  volume = {95},
  number = {9},
  abstract = {We present an analytically tractable variant of the voter model that provides a quantitatively accurate description of beta diversity (two-point correlation function) in two tropical forests. The model exhibits novel scaling behavior that leads to links between ecological measures such as relative species abundance and the species-area relationship.},
  keywords = {BETA-DIVERSITY,TROPICAL FORESTS}
}

