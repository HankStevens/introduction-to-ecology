@article{
  title = {Resolving {{Ecological Questions}} through {{Meta-Analysis}}: \{\textbackslash vphantom\}{{G}}\textbackslash vphantom\{\}oals, {{Metrics}}, and {{Models}}},
  author = {Osenberg, C W and Sarnelle, O and Cooper, S D and Holt, R D},
  date = {1999},
  journaltitle = {Ecology},
  volume = {80},
  number = {4},
  pages = {1105--1117},
  abstract = {We evaluate the goals of meta-analysis, critique its recent application in ecology, and highlight an approach that more explicitly links meta-analysis and ecological theory. One goal of meta-analysis is testing null hypotheses of no response to experimental manipulations. Many ecologists, however, are more interested in quantitatively measuring processes and examining their systematic variation across systems and conditions. This latter goal requires a suite of diverse, ecologically based metrics of effect size, with each appropriately matched to an ecological question of interest. By specifying ecological models, we can develop metrics of effect size that quantify the underlying process or response of interest and are insensitive to extraneous factors irrelevant to the focal question. A model will also help to delineate the set of studies that fit the question addressed by the meta-analysis. We discuss factors that can give rise to heterogeneity in effect sizes (e.g., due to differences in experimental protocol, parameter values, or the structure of the models that describe system dynamics) and illustrate this variation using some simple models of plant competition. Variation in time scale will be one of the most common factors affecting a meta-analysis, by introducing heterogeneity in effect sizes. Different metrics will apply to different time scales, and time-series data will be vital in evaluating the appropriateness of different metrics to different collections of studies. We then illustrate the application of ecological models, and associated metrics of effect size, in meta-analysis by discussing and/or synthesizing data on species interactions, mutual interference between consumers, and individual physiology. We also examine the use of metrics when no single, specific model applies to the synthesized studies. These examples illustrate that the diversity of ecological questions demands a diversity of ecologically meaningful metrics of effect size. The successful application of meta-analysis in ecology will benefit by clear and explicit linkages among ecological theory, the questions being addressed, and the metrics used to summarize the available information.},
  keywords = {ecological models and meta-analysis,effect size i}
}

@article{
  title = {Evolutionary {{Relationships}} between {{Main Taxa}} \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}alvelinus {{Alpinus}} - \{\textbackslash vphantom\}{{S}}\textbackslash vphantom\{\}alvelinus {{Malma Complex}}: \{\textbackslash vphantom\}{{T}}\textbackslash vphantom\{\}he {{Results}} of {{Comparative Analysis}} of the {{Different Authors}}' {{Data}} on the {{Allosymes}}},
  author = {Osinov, A G},
  date = {2001},
  journaltitle = {Voprosy Ikhtiologii},
  volume = {41},
  number = {2},
  pages = {167--183},
  abstract = {Current data and scientific literature were studied on 28 allozyme loci for 49 populations of charrs of the genus Salvelinus, which were represented by the Arctic charr from Central Europe (the Alpine lakes), Northern Europe, Siberia, and the Western shore of the Atlantic, the Tarants charr from Asia and North America, and the Dolly Varden (the northern form from Asia and North America, the southern form from Alaska, Japan, Sakhalin, and the Kuril Islands), and also of one population of Salvelinus leucomaenis, which was taken as an out group. Based on these data, an analysis of the phylogenetic relationships in terms of the Salvelinus alpinus-Salvelinus malma complex was made. It was proposed that the southern form of the Dolly Varden from Japan was closer than all the others to the general precursor of the Salvelinus alpinus-Salvelinus malma complex. The three following groups of populations can be separated out for the southern form of the Dolly Varden: from Japan; from Sakhalin + the Kuril Islands; and the southern part of Alaska + British Columbia + the Aleutian Islands. The northern form of the Dolly Varden from Asia and North America is genetically uniform. For the Arctic charr, two primary phylogenetic groups can be separated from each other. The first group is represented by the Arctic charr of Eurasia (including the population of the Northern Coast of the Atlantic), while the second is represented by the Tarants charr, whose primary area of distribution is in North America and partially in Chukotka. The Arctic charr of Eurasia and the Tarants charr have population groups that are isolated in varying degrees, but their separation took place at later stages of divergence in terms of the two primary phylogenetic lines. Issues of the phylogeny of some charr species close to the Salvelinus alpinus-Salvelinus malma complex were discussed.},
  keywords = {Evolution and Adaptation Systematics and Taxonomy}
}

