@article{
  title = {Biodiversity and {{Ecosystem Services}}: {{A Multilayered Relationship}}},
  author = {Mace, Georgina M. and Norris, Ken and Fitter, Alastair H.},
  date = {2012},
  journaltitle = {Trends in Ecology and Evolution},
  volume = {27},
  number = {1},
  eprint = {21943703},
  eprinttype = {pubmed},
  pages = {19--25},
  issn = {01695347},
  abstract = {The relationship between biodiversity and the rapidly expanding research and policy field of ecosystem services is confused and is damaging efforts to create coherent policy. Using the widely accepted Convention on Biological Diversity definition of biodiversity and work for the UK National Ecosystem Assessment we show that biodiversity has key roles at all levels of the ecosystem service hierarchy: as a regulator of underpinning ecosystem processes, as a final ecosystem service and as a good that is subject to valuation, whether economic or otherwise. Ecosystem science and practice has not yet absorbed the lessons of this complex relationship, which suggests an urgent need to develop the interdisciplinary science of ecosystem management bringing together ecologists, conservation biologists, resource economists and others. © 2011 Elsevier Ltd.},
  isbn = {0169-5347}
}

@article{
  title = {Introduction to {{Statistical Thought}}},
  author = {MacEachern, Steven N},
