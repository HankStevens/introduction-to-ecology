@article{
  title = {Transience and {{Constancy}} of {{Interactions}} in a {{Plant-Frugivore Network}}},
  author = {Yang, Suann and Albert, Réka and Carlo, Tomás A.},
  date = {2013},
  journaltitle = {Ecosphere (Washington, D.C)},
