@article{
  title = {Dispersal, {{Spatial Scale}}, and {{Species Diversity}} in a {{Hierarchically Structured Experimental Landscape}}},
  author = {Cadotte, Marc W. and Fukami, Tadashi},
  date = {2005},
  journaltitle = {Ecology Letters},
  volume = {8},
  number = {5},
  eprint = {21352459},
  eprinttype = {pubmed},
  pages = {548--557},
  issn = {1461023X},
  abstract = {Although there has been growing interest in the effect of dispersal on species diversity, much remains unknown about how dispersal occurring at multiple scales influences diversity. We used an experimental microbial landscape to determine whether dispersal occurring at two different scales - among local communities and among metacommunities - affects diversity differently. At the local scale, dispersal initially had a positive effect and subsequently a neutral effect on diversity, whereas at the metacommunity and landscape scales, dispersal showed a consistently negative effect. The timing in which dispersal affected beta diversity also differed sharply between local communities and metacommunities. These patterns were explained by scale- and time-dependent effects of dispersal in allowing spread of species and in removing spatial refuges from predators. Our results suggest that the relative contribution of opposing mechanisms by which dispersal affects diversity changes considerably over time and space in hierarchical landscapes in which dispersal occurs at multiple scales.},
  isbn = {1461-023X},
  keywords = {Competition,Hierarchy,Metacommunity,Microcosms,Predation,Spatial ecology,Spatial refuge,Species coexistence,Succession,Transient dynamics}
}

@article{
  title = {Dispersal and {{Species Diversity}}: {{A Meta-Analysis}}},
  author = {Cadotte, Marc William},
  date = {2006},
  journaltitle = {The American Naturalist},
  volume = {167},
  number = {6},
  eprint = {16649154},
  eprinttype = {pubmed},
  pages = {913--924},
  issn = {0003-0147},
  abstract = {Species diversity in communities of interacting organisms is thought to be enhanced by dispersal, yet mechanisms predicting this have little to say about what effects differing rates of dispersal have on diversity and how dispersal affects diversity at larger spatial scales. I performed meta-analyses on 23 studies comprising 50 experiments that manipulated species migration and measured community richness or diversity to test three hypotheses: that dispersal increases local diversity; that this effect depends on the rate of dispersal, specifically, that local diversity should be maximized at intermediate dispersal rates or else linearly related to dispersal rate; and that regional diversity may be either unaffected or negatively impacted by dispersal because dispersal tends to homogenize local communities. I found that immigration increased local diversity. Further, in animal studies, diversity appears maximized at intermediate dispersal rates but not with plant studies; however, more standardized studies are needed. Finally, results are ambiguous as to what happens at larger scales, with studies finding either declines or no change in regional diversity with dispersal. Taken together, these results reveal that dispersal has a complex, spatially contingent relationship with patterns of species diversity.},
  isbn = {0003-0147},
  keywords = {dispersal,meta-analysis,metacommunity,richness,spatial}
}

@article{
  title = {Concurrent {{Niche}} and {{Neutral Processes}} in the {{Competition-Colonization Model}} of {{Species Coexistence}}},
  author = {Cadotte, M. W.},
  date = {2007},
  journaltitle = {Proceedings of the Royal Society B: Biological Sciences},
  volume = {274},
  number = {1626},
  eprint = {17711831},
  eprinttype = {pubmed},
  pages = {2739--2744},
  issn = {0962-8452},
  abstract = {The importance of neutral dynamics is contentiously debated in the ecological literature. This debate focuses on neutral theory's assumption of fitness equivalency among individuals, which conflicts with stabilizing fitness that promotes coexistence through niche differentiation. I take advantage of competition-colonization trade-offs between species of aquatic micro-organisms (protozoans and rotifers) to show that equalizing and stabilizing mechanisms can operate simultaneously. Competition trials between species with similar colonization abilities were less likely to result in competitive exclusion than for species further apart. While the stabilizing mechanism (colonization differences) facilitates coexistence at large spatial scales, species with similar colonization abilities also exhibited local coexistence probably due to fitness similarities allowing weak stabilizing mechanisms to operate. These results suggest that neutral- and niche-based mechanisms of coexistence can simultaneously operate at differing temporal and spatial scales, and such a spatially explicit view of coexistence may be one way to reconcile niche and neutral dynamics.},
  isbn = {0962-8452},
  keywords = {colonization trade-off,competition,microcosm,niche versus neutral dynamics,spatial scale}
}

@article{
  title = {Growth {{Consequences}} of {{Soil Nutrient Heterogeneity}} for {{Two Old-Field Herbs}}, {{Ambrosia Artemisiifolia}} and {{Phytolacca Americana}}, {{Grown Individually}} and in {{Combination}}},
  author = {Cahill, J F and Casper, B B},
  date = {1999},
  journaltitle = {Annals of Botany},
  volume = {83},
  number = {4},
  eprint = {1073},
  eprinttype = {pubmed},
  pages = {471--478},
  issn = {0305-7364},
  abstract = {Plant species can respond to small scale soil nutrient heterogeneity\textbackslash textbackslash nby proliferating roots or increasing nutrient uptake kinetics in\textbackslash textbackslash nnutrient-rich patches. Because root response to heterogeneity differs\textbackslash textbackslash namong species, it has been suggested that the distribution of soil\textbackslash textbackslash nresources could influence the outcome of interspecific competition.\textbackslash textbackslash nHowever, studies testing how plants respond to heterogeneity in the\textbackslash textbackslash npresence of neighbours are lacking. In this study, individuals of\textbackslash textbackslash ntwo species, Phytolacca americana L. and Ambrosia artemisiifolia\textbackslash textbackslash nL. were grown individually and in combination in soils with either\textbackslash textbackslash na homogeneous or heterogeneous nutrient distribution. Above-ground\textbackslash textbackslash nbiomass of individually grown plants of both species was greater\textbackslash textbackslash nwhen fertilizer was located in a single patch than when the same\textbackslash textbackslash namount of fertilizer was distributed evenly throughout the soil.\textbackslash textbackslash nAdditionally, both species proliferated roots in high-nutrient patches.\textbackslash textbackslash nA. artemisiifolia exhibited larger root:shoot ratios, increased nitrogen\textbackslash textbackslash ndepletion from nutrient patches, and a higher growth rate than P.\textbackslash textbackslash namericana, suggesting A. artemisiifolia is better suited to find\textbackslash textbackslash nand rapidly exploit nutrient patches. In contrast to individually\textbackslash textbackslash ngrown plants, soil nutrient distribution had no effect on final above-ground\textbackslash textbackslash nplant biomass for either species when grown with neighbours, even\textbackslash textbackslash nthough roots were still concentrated in high nutrient patches. This\textbackslash textbackslash nstudy demonstrates that increased growth of isolated plants as a\textbackslash textbackslash nconsequence of localized soil nutrients is not necessarily an indication\textbackslash textbackslash nthat heterogeneity will affect interspecific encounters. In fact,\textbackslash textbackslash ndespite a significant belowground response, soil nutrient heterogeneity\textbackslash textbackslash nwas inconsequential to above-ground performance when plants were\textbackslash textbackslash ngrown with neighbours. (C) 1999 Annals of Botany Company.},
  isbn = {0305-7364},
  keywords = {ambrosia artemisiifolia,foraging,nutrient heterogeneity,nutrient patches,phytolacca americana,plasticity,pokeweed,proliferation,ragweed,root}
}

