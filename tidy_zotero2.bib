@article{
  title = {Seasonal {{Variation}} in the {{Structure}} of a {{Marine Benthic Microbial Community}}},
  author = {Findlay, R H and Watling, L},
  date = {1998},
  journaltitle = {Microbial Ecology},
  volume = {36},
  number = {1},
  pages = {23--30},
  abstract = {The patterns of seasonal variation in the structure of a marine benthic microbial community were examined using phospholipid fatty acid analysis (PLFA). Principal component analysis of PLFA profiles indicated a strong seasonal pattern dominated the variance within the data set. Three functional groups of microorganisms (phototrophic microeukaryotes, and two groups of anaerobic bacteria) were disproportionately abundant in the communities that mapped to either extreme of the first principle component. Phototrophic microeukaryotes were most abundant and exhibited the greatest relative abundance during periods of cold water. In contrast, the two functional groups of anaerobic bacteria showed the greatest relative abundance during times of warm water. Differential responses by these groups, and macrofaunal deposit feeders, to light intensity and water temperature were offered as the proximal causes of the observed patterns.},
  keywords = {maine,sediment}
}

