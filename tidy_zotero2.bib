  author = {Carpenter, S R and Cottingham, K L and Schindler, D E},
  date = {1992},
  journaltitle = {Trends in Ecology \& Evolution},
  volume = {7},
  number = {10},
  pages = {332--336},
  abstract = {Limnologists are now reconsidering the role of the biota in the phosphorus (P) cycles of takes. Changes in lake communities can have significant consequences for ecosystem P cycles. At seasonal timescales, the relative importance of nitrogen (N) and P as limiting factors for primary production depends in part on zooplankton species composition. Phosphorus storage and recycling by fish and zooplankton can be large components of P budgets, and mobile consumers can be important vectors in P transport. Stability, resilience and resistance of lake P cycles may depend heavily on fluxes to and from upper trophic levels.},
